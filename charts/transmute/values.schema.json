{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transmute Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["global"],
  "properties": {
    "global": {"type": "object", "description": "Global values reserved for parent charts.", "additionalProperties": true},
    "replicaCount": {"type": "integer", "const": 1, "description": "Exactly one replica is supported because Transmute uses local SQLite state."},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "pullPolicy"], "properties": {
      "repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "edge", "main", "master"]}}, "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
    }},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "nameOverride": {"type": "string"}, "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["create", "annotations", "name", "automountServiceAccountToken"], "properties": {
      "create": {"type": "boolean"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "name": {"type": "string"}, "automountServiceAccountToken": {"type": "boolean"}
    }},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}}, "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podSecurityContext": {"type": "object", "additionalProperties": true}, "securityContext": {"type": "object", "additionalProperties": true},
    "containerPorts": {"type": "object", "additionalProperties": false, "required": ["http"], "properties": {
      "http": {"type": "integer", "minimum": 1, "maximum": 65535}
    }},
    "service": {"type": "object", "additionalProperties": false, "required": ["type", "port", "annotations"], "properties": {
      "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "ipFamilyPolicy": {"type": "string", "enum": ["SingleStack", "PreferDualStack", "RequireDualStack"]},
      "ipFamilies": {"type": "array", "items": {"type": "string", "enum": ["IPv4", "IPv6"]}, "maxItems": 2, "uniqueItems": true}
    }},
    "config": {"type": "object", "additionalProperties": false, "required": ["appUrl", "dataDir", "conversionWorkerConcurrency", "conversionJobStaleAfterMinutes", "compressionWorkerConcurrency", "invalidatePdfDigitalSignatures", "maxChunkSize", "allowUnauthenticated", "domainAuthConfigPath"], "properties": {
      "appUrl": {"type": "string"}, "dataDir": {"type": "string", "minLength": 1}, "conversionWorkerConcurrency": {"type": "integer", "minimum": 1},
      "conversionJobStaleAfterMinutes": {"type": "integer", "minimum": 1}, "compressionWorkerConcurrency": {"type": "integer", "minimum": 1},
      "invalidatePdfDigitalSignatures": {"type": "boolean"}, "maxChunkSize": {"type": "integer", "minimum": 0}, "allowUnauthenticated": {"type": "boolean"}, "domainAuthConfigPath": {"type": "string"}
    }},
    "auth": {"type": "object", "additionalProperties": false, "required": ["secretKey", "existingSecret", "secretKeyKey", "algorithm", "accessTokenExpireMinutes"], "properties": {
      "secretKey": {"type": "string", "anyOf": [{"maxLength": 0}, {"minLength": 32}]}, "existingSecret": {"type": "string"}, "secretKeyKey": {"type": "string", "minLength": 1},
      "algorithm": {"type": "string", "minLength": 1}, "accessTokenExpireMinutes": {"type": "integer", "minimum": 1}
    }},
    "oidc": {"type": "object", "additionalProperties": false, "required": ["enabled", "issuerUrl", "internalUrl", "clientId", "clientSecret", "clientSecretKey", "displayName", "usernameClaim", "autoCreateUsers", "autoLaunch"], "properties": {
      "enabled": {"type": "boolean"}, "issuerUrl": {"type": "string"}, "internalUrl": {"type": "string"}, "clientId": {"type": "string"}, "clientSecret": {"type": "string"},
      "clientSecretKey": {"type": "string", "minLength": 1}, "displayName": {"type": "string", "minLength": 1}, "usernameClaim": {"type": "string", "minLength": 1},
      "autoCreateUsers": {"type": "boolean"}, "autoLaunch": {"type": "boolean"}
    }},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"], "properties": {
      "enabled": {"type": "boolean"}, "ingressClassName": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
      "hosts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["host", "paths"], "properties": {"host": {"type": "string", "minLength": 1}, "paths": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "pathType"], "properties": {"path": {"type": "string", "minLength": 1}, "pathType": {"type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"]}}}}}}},
      "tls": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
    }},
    "gatewayAPI": {"type": "object", "additionalProperties": false, "required": ["enabled", "httpRoutes"], "properties": {
      "enabled": {"type": "boolean"}, "httpRoutes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {
        "name": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "parentRefs": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "hostnames": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      }}}
    }},
    "resources": {"type": "object", "additionalProperties": true}, "livenessProbe": {"type": "object", "additionalProperties": true},
    "readinessProbe": {"type": "object", "additionalProperties": true}, "startupProbe": {"type": "object", "additionalProperties": true},
    "persistence": {"type": "object", "additionalProperties": false, "required": ["enabled", "accessModes", "size", "storageClass", "annotations", "mountPath", "existingClaim"], "properties": {
      "enabled": {"type": "boolean", "const": true}, "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "size": {"type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$"},
      "storageClass": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "mountPath": {"type": "string", "minLength": 1}, "existingClaim": {"type": "string"}
    }},
    "externalSecrets": {"type": "object", "additionalProperties": false, "required": ["enabled", "apiVersion", "refreshInterval", "items"], "properties": {
      "enabled": {"type": "boolean"}, "apiVersion": {"type": "string", "enum": ["external-secrets.io/v1", "external-secrets.io/v1beta1"]}, "refreshInterval": {"type": "string", "minLength": 1},
      "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["spec"], "properties": {
        "name": {"type": "string"}, "fullnameOverride": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "spec": {"type": "object", "additionalProperties": true}
      }}}
    }},
    "env": {"type": "array", "items": {"type": "object", "additionalProperties": true}, "description": "Additional container environment variables."},
    "envFrom": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "volumeMounts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "volumes": {"type": "array", "items": {"type": "object", "additionalProperties": true}, "description": "Additional pod volumes."},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressFrom", "egressIsolation", "extraEgress"], "properties": {
      "enabled": {"type": "boolean"}, "ingressFrom": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "egressIsolation": {"type": "boolean"}, "extraEgress": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
    }},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}}, "tolerations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "affinity": {"type": "object", "additionalProperties": true}, "topologySpreadConstraints": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "priorityClassName": {"type": "string"}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0}
  }
}
