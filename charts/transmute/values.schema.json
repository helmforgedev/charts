{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transmute values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object"
    },
    "service": {
      "type": "object"
    },
    "config": {
      "type": "object"
    },
    "auth": {
      "type": "object"
    },
    "oidc": {
      "type": "object"
    },
    "ingress": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "persistence": {
      "type": "object"
    },
    "externalSecrets": {
      "type": "object"
    },
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "gatewayAPI": {
      "type": "object",
      "description": "Gateway API configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable canonical Gateway API HTTPRoutes"
        },
        "httpRoutes": {
          "type": "array",
          "description": "List of HTTPRoute definitions",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  }
}