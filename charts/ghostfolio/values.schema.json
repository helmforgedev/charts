{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Ghostfolio chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values consumed by dependencies.",
      "additionalProperties": true
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["latest", "stable", "edge", "nightly", "main", "master"] }
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ghostfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootUrl",
        "trustProxy",
        "authTokenEnabled",
        "cronEnabled",
        "securityHeadersEnabled",
        "mcpEnabled",
        "rateLimitingEnabled",
        "readOnlyModeEnabled",
        "logLevels",
        "existingSecret",
        "accessTokenSaltKey",
        "jwtSecretKey",
        "extraEnv",
        "extraEnvFrom"
      ],
      "properties": {
        "rootUrl": { "type": "string", "pattern": "^$|^https?://" },
        "trustProxy": { "type": ["string", "integer", "boolean"] },
        "authTokenEnabled": { "type": "boolean" },
        "cronEnabled": { "type": "boolean" },
        "securityHeadersEnabled": { "type": "boolean" },
        "mcpEnabled": { "type": "boolean" },
        "rateLimitingEnabled": { "type": "boolean" },
        "readOnlyModeEnabled": { "type": "boolean" },
        "logLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["debug", "error", "fatal", "log", "verbose", "warn"]
          }
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253
        },
        "accessTokenSaltKey": { "type": "string", "minLength": 1 },
        "jwtSecretKey": { "type": "string", "minLength": 1 },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
            },
            "additionalProperties": true
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "issuer",
        "clientId",
        "existingSecret",
        "clientSecretKey",
        "scopes",
        "callbackUrl",
        "authorizationUrl",
        "tokenUrl",
        "userInfoUrl"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string", "pattern": "^$|^https://" },
        "clientId": { "type": "string" },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253
        },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "callbackUrl": { "type": "string", "pattern": "^$|^https://" },
        "authorizationUrl": { "type": "string", "pattern": "^$|^https://" },
        "tokenUrl": { "type": "string", "pattern": "^$|^https://" },
        "userInfoUrl": { "type": "string", "pattern": "^$|^https://" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external"],
      "properties": {
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "existingSecret",
            "urlKey",
            "directUrlKey",
            "directUrlEnabled",
            "host",
            "port",
            "networkPolicyPeers"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            },
            "urlKey": { "type": "string", "minLength": 1 },
            "directUrlKey": { "type": "string", "minLength": 1 },
            "directUrlEnabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "networkPolicyPeers": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "architecture", "auth", "standalone"],
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "enum": ["standalone", "replication"] },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["database", "username", "password", "postgresPassword"],
          "properties": {
            "database": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "postgresPassword": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretUserPasswordKey": { "type": "string", "minLength": 1 }
          }
        },
        "standalone": {
          "type": "object",
          "additionalProperties": true,
          "required": ["persistence", "resources"],
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "required": ["enabled", "size"],
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string", "minLength": 1 }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "limits"],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": ["string", "number"] },
                    "memory": { "type": ["string", "number"] }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": ["string", "number"] },
                    "memory": { "type": ["string", "number"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "architecture", "auth", "standalone", "external"],
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "enum": ["standalone", "replication"] },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "password"],
          "properties": {
            "enabled": { "type": "boolean" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
          }
        },
        "standalone": {
          "type": "object",
          "additionalProperties": true,
          "required": ["persistence", "resources"],
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "required": ["enabled", "size"],
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string", "minLength": 1 }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "limits"],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": ["string", "number"] },
                    "memory": { "type": ["string", "number"] }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": ["string", "number"] },
                    "memory": { "type": ["string", "number"] }
                  }
                }
              }
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "host",
            "port",
            "database",
            "existingSecret",
            "passwordKey",
            "networkPolicyPeers"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "integer", "minimum": 0 },
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            },
            "passwordKey": { "type": "string", "minLength": 1 },
            "networkPolicyPeers": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "refreshInterval", "items"],
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "fullnameOverride": { "type": "string" },
              "labels": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "spec": { "type": "object", "additionalProperties": true }
            },
            "required": ["spec"],
            "anyOf": [{ "required": ["name"] }, { "required": ["fullnameOverride"] }]
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "automountServiceAccountToken": { "type": "boolean", "const": false }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations", "ipFamilyPolicy", "ipFamilies"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "ipFamilyPolicy": {
          "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"]
        },
        "ipFamilies": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["IPv4", "IPv6"] }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "rootUrlScheme", "httpRoutes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "rootUrlScheme": { "enum": ["http", "https"] },
        "httpRoutes": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "waitForServices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "timeoutSeconds", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": true,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": ["string", "number"] },
                "memory": { "type": ["string", "number"] }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": true,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": ["string", "number"] },
                "memory": { "type": ["string", "number"] }
              }
            }
          }
        }
      }
    },
    "containerPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http"],
      "properties": {
        "http": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "description": "Real Ghostfolio HTTP process listener configured through PORT."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": true,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "fsGroupChangePolicy", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "fsGroupChangePolicy": { "enum": ["Always", "OnRootMismatch"] },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["RuntimeDefault", "Localhost", "Unconfined"] },
            "localhostProfile": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "Localhost" } } },
              "then": { "required": ["localhostProfile"] },
              "else": { "not": { "required": ["localhostProfile"] } }
            }
          ]
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "add": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "runtimeStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeLimit"],
      "properties": {
        "sizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$"
        }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "egressIsolation", "ingressFrom", "dnsEgress", "allowPublicInternet", "extraEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "egressIsolation": { "type": "boolean" },
        "ingressFrom": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "dnsEgress": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "allowPublicInternet": { "type": "boolean" },
        "extraEgress": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "affinity": { "type": "object", "additionalProperties": true },
    "topologySpreadConstraints": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "priorityClassName": { "type": "string" },
    "extraVolumes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  },
  "required": [
    "nameOverride",
    "fullnameOverride",
    "commonLabels",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "ghostfolio",
    "oidc",
    "database",
    "postgresql",
    "redis",
    "externalSecrets",
    "serviceAccount",
    "service",
    "ingress",
    "gatewayAPI",
    "probes",
    "waitForServices",
    "containerPorts",
    "resources",
    "podSecurityContext",
    "securityContext",
    "runtimeStorage",
    "terminationGracePeriodSeconds",
    "networkPolicy",
    "podLabels",
    "podAnnotations",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "priorityClassName",
    "extraVolumes",
    "extraVolumeMounts"
  ]
}
