{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "containerPorts", "auth", "keyring", "openhuman", "persistence", "projectsPersistence", "serviceAccount", "service", "ingress", "gatewayAPI", "externalSecrets", "probes", "resources", "podSecurityContext", "securityContext", "networkPolicy"],
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object"},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+@sha256:[a-f0-9]{64}$"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "containerPorts": {"type": "object", "additionalProperties": false, "required": ["http"], "properties": {"http": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "auth": {"type": "object", "additionalProperties": false, "required": ["existingSecret", "key"], "properties": {"existingSecret": {"type": "string"}, "key": {"type": "string", "minLength": 1}}},
    "keyring": {"type": "object", "additionalProperties": false, "required": ["existingSecret", "key"], "properties": {"existingSecret": {"type": "string"}, "key": {"type": "string", "minLength": 1}}},
    "openhuman": {"type": "object", "additionalProperties": false, "required": ["backendUrl", "appEnv", "logLevel", "allowedOrigins", "analyticsEnabled", "extraEnv", "envFrom"], "properties": {"backendUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "appEnv": {"enum": ["production", "staging"]}, "logLevel": {"type": "string", "minLength": 1}, "allowedOrigins": {"type": "string"}, "analyticsEnabled": {"type": "boolean"}, "extraEnv": {"type": "array", "items": {"type": "object"}}, "envFrom": {"type": "array", "items": {"type": "object"}}}},
    "persistence": {"type": "object", "additionalProperties": false, "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"], "properties": {"enabled": {"const": true}, "existingClaim": {"type": "string"}, "storageClass": {"type": "string"}, "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}}, "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}, "retain": {"type": "boolean"}, "annotations": {"type": "object"}}},
    "projectsPersistence": {"type": "object", "additionalProperties": false, "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"], "properties": {"enabled": {"const": true}, "existingClaim": {"type": "string"}, "storageClass": {"type": "string"}, "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}}, "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}, "retain": {"type": "boolean"}, "annotations": {"type": "object"}}},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["create", "name", "annotations", "automountServiceAccountToken"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"type": "object"}, "automountServiceAccountToken": {"type": "boolean"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["type", "port", "annotations", "ipFamilyPolicy", "ipFamilies"], "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "annotations": {"type": "object"}, "ipFamilyPolicy": {"type": "string"}, "ipFamilies": {"type": "array", "items": {"enum": ["IPv4", "IPv6"]}}}},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"], "properties": {"enabled": {"type": "boolean"}, "ingressClassName": {"type": "string"}, "annotations": {"type": "object"}, "hosts": {"type": "array"}, "tls": {"type": "array"}}},
    "gatewayAPI": {"type": "object", "additionalProperties": false, "required": ["enabled", "httpRoutes"], "properties": {"enabled": {"type": "boolean"}, "httpRoutes": {"type": "array"}}},
    "externalSecrets": {"type": "object", "additionalProperties": false, "required": ["enabled", "refreshInterval", "items"], "properties": {"enabled": {"type": "boolean"}, "refreshInterval": {"type": "string"}, "items": {"type": "array"}}},
    "probes": {"type": "object", "additionalProperties": false, "required": ["startup", "liveness", "readiness"], "properties": {
      "startup": {"type": "object", "additionalProperties": false, "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"], "properties": {"enabled": {"type": "boolean"}, "initialDelaySeconds": {"type": "integer", "minimum": 0}, "periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "failureThreshold": {"type": "integer", "minimum": 1}}},
      "liveness": {"type": "object", "additionalProperties": false, "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"], "properties": {"enabled": {"type": "boolean"}, "initialDelaySeconds": {"type": "integer", "minimum": 0}, "periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "failureThreshold": {"type": "integer", "minimum": 1}}},
      "readiness": {"type": "object", "additionalProperties": false, "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"], "properties": {"enabled": {"type": "boolean"}, "initialDelaySeconds": {"type": "integer", "minimum": 0}, "periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "failureThreshold": {"type": "integer", "minimum": 1}}}
    }},
    "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {"requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": ["string", "number"]}, "memory": {"type": ["string", "number"]}}}, "limits": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": ["string", "number"]}, "memory": {"type": ["string", "number"]}}}}},
    "podSecurityContext": {"type": "object", "additionalProperties": false, "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "fsGroupChangePolicy", "seccompProfile"], "properties": {"runAsNonRoot": {"type": "boolean"}, "runAsUser": {"type": "integer", "minimum": 1}, "runAsGroup": {"type": "integer", "minimum": 1}, "fsGroup": {"type": "integer", "minimum": 1}, "fsGroupChangePolicy": {"enum": ["Always", "OnRootMismatch"]}, "seccompProfile": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "RuntimeDefault"}}}}},
    "securityContext": {"type": "object", "additionalProperties": false, "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"], "properties": {"allowPrivilegeEscalation": {"const": false}, "readOnlyRootFilesystem": {"const": true}, "capabilities": {"type": "object", "additionalProperties": false, "required": ["drop"], "properties": {"drop": {"type": "array", "contains": {"const": "ALL"}}}}}},
    "strategy": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "Recreate"}}},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "nodeSelector": {"type": "object", "properties": {"kubernetes.io/arch": {"const": "amd64"}, "kubernetes.io/os": {"const": "linux"}}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "podDisruptionBudget": {"type": "object", "additionalProperties": false, "required": ["enabled", "minAvailable"], "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^(100|[0-9]{1,2})%$"}]}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressFrom", "allowInternet", "extraEgress"], "properties": {"enabled": {"type": "boolean"}, "ingressFrom": {"type": "array"}, "allowInternet": {"type": "boolean"}, "extraEgress": {"type": "array"}}},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "extraContainers": {"type": "array"},
    "extraInitContainers": {"type": "array"},
    "extraManifests": {"type": "array"}
  },
  "$defs": {
    "secretRef": {"type": "object", "additionalProperties": false, "required": ["existingSecret", "key"], "properties": {"existingSecret": {"type": "string"}, "key": {"type": "string", "minLength": 1}}},
    "persistence": {"type": "object", "additionalProperties": false, "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"], "properties": {"enabled": {"const": true}, "existingClaim": {"type": "string"}, "storageClass": {"type": "string"}, "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}}, "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}, "retain": {"type": "boolean"}, "annotations": {"type": "object"}}},
    "probe": {"type": "object", "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"], "properties": {"enabled": {"type": "boolean"}, "initialDelaySeconds": {"type": "integer", "minimum": 0}, "periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "failureThreshold": {"type": "integer", "minimum": 1}}}
  }
}
