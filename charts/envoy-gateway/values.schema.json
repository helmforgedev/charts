{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Envoy Gateway Helm Chart Values",
  "description": "Values for the Envoy Gateway Helm chart - modern Gateway API implementation with rate limiting and observability",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "profile": {
      "type": "string",
      "description": "Profile preset for quick deployment configuration",
      "enum": ["dev", "staging", "production-ha", "custom"],
      "default": "custom"
    },
    "namespaceOverride": {
      "type": "string",
      "description": "Override the namespace used by chart-managed namespaced resources",
      "default": ""
    },
    "crds": {
      "type": "object",
      "description": "Bridge lifecycle for bundled or standalone Envoy Gateway and Gateway API CRDs",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Install bundled CRDs; existing releases must migrate through this bridge before disabling",
          "default": true
        },
        "gatewayAPI": {
          "type": "object",
          "description": "Internal Gateway API CRD subchart settings",
          "additionalProperties": true
        },
        "global": {
          "type": "object",
          "description": "Helm global values forwarded to the CRD subchart",
          "additionalProperties": true
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name",
      "default": ""
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name",
      "default": ""
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Image pull secrets",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "description": "Controller Service configuration",
      "properties": {
        "ipFamilyPolicy": {
          "type": ["string", "null"],
          "description": "Dual-stack ipFamilyPolicy for controller Services",
          "enum": [null, "SingleStack", "PreferDualStack", "RequireDualStack"]
        },
        "ipFamilies": {
          "type": "array",
          "description": "Dual-stack ipFamilies for controller Services",
          "items": {
            "type": "string",
            "enum": ["IPv4", "IPv6"]
          },
          "maxItems": 2
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "description": "Annotations to add to all pods"
    },
    "podLabels": {
      "type": "object",
      "description": "Labels to add to all pods"
    },
    "controller": {
      "type": "object",
      "description": "Controller configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "description": "Number of controller replicas (overridden by profile)",
          "minimum": 1,
          "default": 1
        },
        "image": {
          "type": "object",
          "description": "Controller image configuration",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Controller image repository",
              "default": "docker.io/envoyproxy/gateway"
            },
            "tag": {
              "type": "string",
              "description": "Controller image tag",
              "default": "v1.9.0"
            },
            "pullPolicy": {
              "type": "string",
              "description": "Controller image pull policy",
              "enum": ["Always", "IfNotPresent", "Never"],
              "default": "IfNotPresent"
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for controller",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+(m|[0-9]+)?$",
                  "description": "CPU request"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|M|G)?$",
                  "description": "Memory request"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+(m|[0-9]+)?$",
                  "description": "CPU limit"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|M|G)?$",
                  "description": "Memory limit"
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "description": "Controller Service configuration",
          "properties": {
            "ipFamilyPolicy": {
              "type": ["string", "null"],
              "description": "Dual-stack ipFamilyPolicy for controller Services",
              "enum": [null, "SingleStack", "PreferDualStack", "RequireDualStack"]
            },
            "ipFamilies": {
              "type": "array",
              "description": "Dual-stack ipFamilies for controller Services",
              "items": {
                "type": "string",
                "enum": ["IPv4", "IPv6"]
              },
              "maxItems": 2
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "description": "Node selector for controller pods"
        },
        "tolerations": {
          "type": "array",
          "description": "Tolerations for controller pods",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object",
          "description": "Affinity rules for controller pods"
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Pod security context for controller"
        },
        "securityContext": {
          "type": "object",
          "description": "Container security context for controller"
        }
      }
    },
    "proxy": {
      "type": "object",
      "description": "Proxy configuration",
      "properties": {
        "ipFamily": {
          "type": "string",
          "description": "EnvoyProxy IP family",
          "enum": ["", "IPv4", "IPv6", "DualStack"],
          "default": ""
        },
        "mode": {
          "type": "string",
          "description": "Deployment mode: Deployment or DaemonSet",
          "enum": ["Deployment", "DaemonSet"],
          "default": "Deployment"
        },
        "replicaCount": {
          "type": "integer",
          "description": "Number of replicas (Deployment mode only)",
          "minimum": 1,
          "default": 1
        },
        "image": {
          "type": "object",
          "description": "Proxy image configuration",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Proxy image repository",
              "default": "docker.io/envoyproxy/envoy"
            },
            "tag": {
              "type": "string",
              "description": "Proxy image tag",
              "default": "distroless-v1.39.0"
            },
            "pullPolicy": {
              "type": "string",
              "description": "Proxy image pull policy",
              "enum": ["Always", "IfNotPresent", "Never"],
              "default": "IfNotPresent"
            }
          }
        },
        "shutdownManager": {
          "type": "object",
          "description": "Shutdown manager sidecar configuration",
          "properties": {
            "image": {
              "type": "object",
              "description": "Shutdown manager sidecar image",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Shutdown manager sidecar image repository",
                  "default": "docker.io/envoyproxy/gateway"
                },
                "tag": {
                  "type": "string",
                  "description": "Shutdown manager sidecar image tag",
                  "default": "v1.9.0"
                },
                "pullPolicy": {
                  "type": "string",
                  "description": "Shutdown manager image pull policy",
                  "enum": ["Always", "IfNotPresent", "Never"],
                  "default": "IfNotPresent"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for proxy",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+(m|[0-9]+)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|M|G)?$"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+(m|[0-9]+)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|M|G)?$"
                }
              }
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "description": "Horizontal Pod Autoscaler (Deployment mode only)",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable HPA",
              "default": false
            },
            "minReplicas": {
              "type": "integer",
              "description": "Minimum number of replicas",
              "minimum": 1,
              "default": 2
            },
            "maxReplicas": {
              "type": "integer",
              "description": "Maximum number of replicas",
              "minimum": 1,
              "default": 10
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "description": "Target CPU utilization percentage",
              "minimum": 1,
              "maximum": 100,
              "default": 80
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "description": "Node selector for proxy pods"
        },
        "tolerations": {
          "type": "array",
          "description": "Tolerations for proxy pods",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object",
          "description": "Affinity rules for proxy pods"
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Pod security context for proxy"
        },
        "securityContext": {
          "type": "object",
          "description": "Container security context for proxy"
        },
        "service": {
          "type": "object",
          "description": "Service configuration for proxy",
          "properties": {
            "type": {
              "type": "string",
              "description": "Service type",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
              "default": "LoadBalancer"
            },
            "httpPort": {
              "type": "integer",
              "description": "HTTP port",
              "minimum": 1,
              "maximum": 65535,
              "default": 80
            },
            "httpsPort": {
              "type": "integer",
              "description": "HTTPS port",
              "minimum": 1,
              "maximum": 65535,
              "default": 443
            },
            "annotations": {
              "type": "object",
              "description": "Annotations for proxy service"
            }
          }
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "description": "Gateway API example resources configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable chart-managed Gateway API helper resources",
          "default": true
        },
        "examples": {
          "type": "object",
          "description": "Example Gateway and HTTPRoute resources",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Create example resources",
              "default": true
            },
            "namespace": {
              "type": "string",
              "description": "Namespace for example resources (defaults to Release.Namespace)",
              "default": ""
            }
          }
        }
      }
    },
    "certificates": {
      "type": "object",
      "description": "Certificate management configuration",
      "properties": {
        "certManager": {
          "type": "object",
          "description": "cert-manager integration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable cert-manager integration",
              "default": false
            },
            "issuer": {
              "type": "string",
              "description": "Issuer name (ClusterIssuer or Issuer)",
              "default": "selfsigned"
            },
            "issuerKind": {
              "type": "string",
              "description": "Issuer kind",
              "enum": ["ClusterIssuer", "Issuer"],
              "default": "ClusterIssuer"
            }
          }
        },
        "autoProvision": {
          "type": "boolean",
          "description": "Auto-provision certificates for Gateway listeners",
          "default": false
        }
      }
    },
    "monitoring": {
      "type": "object",
      "description": "Monitoring and observability configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable monitoring (Prometheus)",
          "default": false
        },
        "prometheus": {
          "type": "object",
          "description": "Prometheus configuration",
          "properties": {
            "serviceMonitor": {
              "type": "boolean",
              "description": "Create ServiceMonitor for Prometheus Operator",
              "default": true
            },
            "prometheusRule": {
              "type": "boolean",
              "description": "Create PrometheusRule with alerts",
              "default": false
            },
            "namespace": {
              "type": "string",
              "description": "Namespace for ServiceMonitor and PrometheusRule (defaults to Release.Namespace)",
              "default": ""
            }
          }
        },
        "grafana": {
          "type": "object",
          "description": "Grafana dashboard configuration",
          "properties": {
            "dashboards": {
              "type": "boolean",
              "description": "Create Grafana dashboards as ConfigMaps",
              "default": false
            },
            "namespace": {
              "type": "string",
              "description": "Namespace for dashboard ConfigMaps",
              "default": ""
            }
          }
        },
        "accessLogs": {
          "type": "object",
          "description": "Access logs configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable access logs",
              "default": true
            },
            "format": {
              "type": "string",
              "description": "Access log format",
              "enum": ["json", "text"],
              "default": "json"
            }
          }
        }
      }
    },
    "rateLimiting": {
      "type": "object",
      "description": "Rate limiting configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable rate limiting",
          "default": false
        },
        "service": {
          "type": "object",
          "description": "Envoy global rate limit service configuration",
          "properties": {
            "image": {
              "type": "object",
              "description": "Rate limit service image deployed by Envoy Gateway",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Rate limit service image repository",
                  "default": "docker.io/envoyproxy/ratelimit"
                },
                "tag": {
                  "type": "string",
                  "description": "Rate limit service image tag",
                  "default": "17b1956c"
                }
              }
            }
          }
        },
        "redis": {
          "type": "object",
          "description": "Redis configuration for rate limiting backend",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Deploy Redis StatefulSet",
              "default": false
            },
            "resources": {
              "type": "object",
              "description": "Resource requests and limits for Redis",
              "properties": {
                "requests": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^[0-9]+(m|[0-9]+)?$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[0-9]+(Mi|Gi|M|G)?$"
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^[0-9]+(m|[0-9]+)?$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[0-9]+(Mi|Gi|M|G)?$"
                    }
                  }
                }
              }
            },
            "persistence": {
              "type": "object",
              "description": "Redis persistence configuration",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable persistent storage",
                  "default": false
                },
                "size": {
                  "type": "string",
                  "description": "PVC size",
                  "pattern": "^[0-9]+(Mi|Gi|M|G|Ti|T)?$",
                  "default": "2Gi"
                },
                "storageClass": {
                  "type": "string",
                  "description": "Storage class name",
                  "default": ""
                }
              }
            },
            "extraArgs": {
              "type": "array",
              "description": "Additional Redis command-line arguments",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "externalRedis": {
          "type": "object",
          "description": "External Redis configuration (when redis.enabled is false)",
          "properties": {
            "host": {
              "type": "string",
              "description": "Redis host"
            },
            "port": {
              "type": "integer",
              "description": "Redis port",
              "minimum": 1,
              "maximum": 65535,
              "default": 6379
            },
            "auth": {
              "type": "object",
              "description": "Redis authentication",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable authentication",
                  "default": false
                },
                "secretName": {
                  "type": "string",
                  "description": "Secret containing Redis password"
                },
                "secretKey": {
                  "type": "string",
                  "description": "Key in secret containing password",
                  "default": "password"
                }
              }
            }
          }
        },
        "presets": {
          "type": "object",
          "description": "Rate limit presets",
          "properties": {
            "api": {
              "type": "boolean",
              "description": "API preset: 100 requests/minute per IP",
              "default": false
            },
            "strict": {
              "type": "boolean",
              "description": "Strict preset: 10 requests/minute per IP",
              "default": false
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security and hardening configuration",
      "properties": {
        "networkPolicies": {
          "type": "boolean",
          "description": "Enable rendering of NetworkPolicy resources for zero-trust networking",
          "default": false
        },
        "networkPolicy": {
          "type": "object",
          "description": "NetworkPolicy rule extensions used when security.networkPolicies is enabled",
          "properties": {
            "dns": {
              "type": "object",
              "description": "Cluster DNS selector used by controller and rate-limit NetworkPolicies",
              "properties": {
                "namespace": {
                  "type": "string",
                  "description": "Namespace containing cluster DNS pods",
                  "minLength": 1,
                  "default": "kube-system"
                },
                "podLabels": {
                  "type": "object",
                  "description": "Labels selecting cluster DNS pods",
                  "additionalProperties": { "type": "string" },
                  "minProperties": 1,
                  "default": { "k8s-app": "kube-dns" }
                }
              }
            },
            "extraEgress": {
              "type": "array",
              "description": "Additional complete egress rules appended to the controller NetworkPolicy",
              "items": { "type": "object" },
              "default": []
            }
          }
        },
        "podSecurityStandards": {
          "type": "boolean",
          "description": "Enable PodSecurityStandard restricted mode",
          "default": true
        }
      }
    },
    "highAvailability": {
      "type": "object",
      "description": "High availability configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable HA mode (controller replicas, proxy DaemonSet, anti-affinity, PDB)",
          "default": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "description": "PodDisruptionBudget configuration",
          "properties": {
            "minAvailable": {
              "type": "integer",
              "description": "Minimum available pods during disruption",
              "minimum": 0,
              "default": 1
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "description": "ServiceAccount configuration",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create service account",
          "default": true
        },
        "name": {
          "type": "string",
          "description": "Service account name (generated if not set; must be envoy-gateway when rate limiting is enabled)",
          "default": ""
        },
        "annotations": {
          "type": "object",
          "description": "Annotations for service account"
        }
      }
    },
    "rbac": {
      "type": "object",
      "description": "RBAC configuration",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create RBAC resources",
          "default": true
        }
      }
    },
    "gatewayClass": {
      "type": "object",
      "description": "GatewayClass configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "GatewayClass name",
          "default": "envoy-gateway"
        },
        "create": {
          "type": "boolean",
          "description": "Create GatewayClass resource",
          "default": true
        }
      }
    },
    "gateway": {
      "type": "object",
      "description": "Default Gateway resource configuration",
      "additionalProperties": false,
      "required": ["create", "name", "allowedListeners", "listeners"],
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a default Gateway resource",
          "default": true
        },
        "name": {
          "type": "string",
          "description": "Gateway name; defaults to the Helm release name",
          "default": ""
        },
        "allowedListeners": {
          "$ref": "#/definitions/allowedListeners"
        },
        "listeners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "https"],
          "properties": {
            "http": {
              "$ref": "#/definitions/httpListener"
            },
            "https": {
              "$ref": "#/definitions/httpsListener"
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "description": "Cleanup hook configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run a pre-delete cleanup Job for chart-managed Gateways and GatewayClass",
          "default": true
        },
        "image": {
          "type": "object",
          "description": "Cleanup hook image",
          "properties": {
            "repository": {
              "type": "string",
              "description": "kubectl image repository",
              "default": "docker.io/helmforge/kubectl"
            },
            "tag": {
              "type": "string",
              "description": "kubectl image tag",
              "default": "1.35.3"
            },
            "pullPolicy": {
              "type": "string",
              "description": "Cleanup image pull policy",
              "default": "IfNotPresent"
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "description": "Timeout in seconds for Gateway and GatewayClass cleanup operations",
          "default": 90
        },
        "resources": {
          "type": "object",
          "description": "Cleanup hook resource requests and limits"
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "description": "ExternalSecrets configuration (GR-061)",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "apiVersion": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "secretStoreRef": { "type": "object" },
        "target": { "type": "object" },
        "data": { "type": "array" }
      }
    }
  },
  "definitions": {
    "allowedListeners": {
      "type": "object",
      "description": "Gateway API constraints for ListenerSets attaching to the Gateway",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": {
              "type": "string",
              "enum": ["All", "None", "Same", "Selector"]
            },
            "selector": {
              "$ref": "#/definitions/labelSelector"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "from": { "const": "Selector" } },
                "required": ["from"]
              },
              "then": { "required": ["selector"] },
              "else": { "not": { "required": ["selector"] } }
            }
          ]
        }
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": {
                "type": "string",
                "enum": ["In", "NotIn", "Exists", "DoesNotExist"]
              },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "operator": { "enum": ["In", "NotIn"] } },
                  "required": ["operator"]
                },
                "then": {
                  "required": ["values"],
                  "properties": { "values": { "minItems": 1 } }
                },
                "else": {
                  "properties": { "values": { "maxItems": 0 } }
                }
              }
            ]
          }
        }
      }
    },
    "allowedRoutes": {
      "type": "object",
      "description": "Gateway API constraints for Routes attaching to a listener",
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "group": { "type": "string" },
              "kind": { "type": "string", "minLength": 1 }
            }
          }
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "enum": ["All", "Same", "Selector"]
            },
            "selector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "matchExpressions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["key", "operator"],
                    "properties": {
                      "key": { "type": "string", "minLength": 1 },
                      "operator": {
                        "type": "string",
                        "enum": ["In", "NotIn", "Exists", "DoesNotExist"]
                      },
                      "values": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": { "operator": { "enum": ["In", "NotIn"] } },
                          "required": ["operator"]
                        },
                        "then": {
                          "required": ["values"],
                          "properties": { "values": { "minItems": 1 } }
                        },
                        "else": { "not": { "required": ["values"] } }
                      }
                    ]
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "from": { "const": "Selector" } },
                "required": ["from"]
              },
              "then": { "required": ["selector"] },
              "else": { "not": { "required": ["selector"] } }
            }
          ]
        }
      }
    },
    "httpListener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "allowedRoutes"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 80 },
        "allowedRoutes": { "$ref": "#/definitions/allowedRoutes" }
      }
    },
    "httpsListener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "tls", "allowedRoutes"],
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 443 },
        "allowedRoutes": { "$ref": "#/definitions/allowedRoutes" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["Terminate", "Passthrough"] },
            "certificateRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "namespace"],
              "properties": {
                "name": { "type": "string" },
                "namespace": { "type": "string" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": { "const": true },
              "tls": {
                "properties": { "mode": { "const": "Terminate" } },
                "required": ["mode"]
              }
            },
            "required": ["enabled", "tls"]
          },
          "then": {
            "properties": {
              "tls": {
                "required": ["certificateRef"],
                "properties": {
                  "certificateRef": {
                    "required": ["name"],
                    "properties": { "name": { "minLength": 1 } }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
