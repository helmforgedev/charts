            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9/_-]*[A-Za-z0-9_-])?$"
            },
            "region": {
              "type": "string"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https?://[^ @]+$"
            },
            "allowInsecureEndpoint": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "sse": {
              "type": "string",
