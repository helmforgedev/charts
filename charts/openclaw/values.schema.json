        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.+@sha256:[a-f0-9]{64}$",
          "not": {
            "pattern": "^latest(@|$)"
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
