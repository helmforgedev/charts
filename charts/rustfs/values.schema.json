{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "architecture": {
      "type": "string",
      "enum": [
        "standalone",
        "distributed",
        "cluster"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "commonLabels": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessKey": {
          "type": "string",
          "minLength": 3
        },
        "secretKey": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 8
            }
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretAccessKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "existingSecretSecretKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "rpcSecret": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 32
            }
          ]
        },
        "rpcExistingSecret": {
          "type": "string"
        },
        "rpcSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consoleEnabled": {
          "type": "boolean"
        },
        "externalAddress": {
          "type": "string"
        },
        "corsAllowedOrigins": {
          "type": "string"
        },
        "consoleCorsAllowedOrigins": {
          "type": "string"
        },
        "logLevel": {
          "type": "string"
        }
      }
    },
    "containerPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "console"],
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "console": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadOnlyMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "consoleService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressClassName": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "consoleIngress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressClassName": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "livenessProbe": {
      "allOf": [
        { "$ref": "#/definitions/probe" },
        { "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"] }
      ]
    },
    "readinessProbe": {
      "allOf": [
        { "$ref": "#/definitions/probe" },
        { "required": ["periodSeconds", "timeoutSeconds"] }
      ]
    },
    "startupProbe": {
      "allOf": [
        { "$ref": "#/definitions/probe" },
        { "required": ["periodSeconds", "failureThreshold"] }
      ]
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(100|[0-9]{1,2})%$"
            }
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiIngressFrom", "consoleIngressFrom"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiIngressFrom": { "type": "array", "items": { "type": "object" } },
        "consoleIngressFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "extraManifests": {
      "type": "array"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "replication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "peers",
        "buckets"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "bucket",
            "site"
          ]
        },
        "localEndpoint": {
          "type": "string",
          "pattern": "^(https?://[^/@\\s?#]+/?)?$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "endpoint",
              "existingSecret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
                "not": {
                  "const": "local"
                },
                "maxLength": 58
              },
              "endpoint": {
                "type": "string",
                "pattern": "^https?://[^/@\\s?#]+/?$"
              },
              "existingSecret": {
                "type": "string",
                "minLength": 1
              },
              "accessKeyKey": {
                "type": "string",
                "minLength": 1
              },
              "secretKeyKey": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sourceBucket",
              "destinationPeer",
              "destinationBucket",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sourceBucket": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
              },
              "destinationPeer": {
                "type": "string",
                "minLength": 1
              },
              "destinationBucket": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "prefix": {
                "type": "string"
              },
              "replicate": {
                "type": "string",
                "pattern": "^(delete|delete-marker|existing-objects)(,(delete|delete-marker|existing-objects))*$"
              },
              "createBuckets": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "probePort": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 65535 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["exec"] },
        { "required": ["grpc"] },
        { "required": ["httpGet"] },
        { "required": ["tcpSocket"] }
      ],
      "properties": {
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "grpc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "service": { "type": "string" }
          }
        },
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "host": { "type": "string" },
            "httpHeaders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "value": { "type": "string" }
                }
              }
            },
            "path": { "type": "string", "pattern": "^/" },
            "port": { "$ref": "#/definitions/probePort" },
            "scheme": { "type": "string", "enum": ["HTTP", "HTTPS"] }
          }
        },
        "tcpSocket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "host": { "type": "string" },
            "port": { "$ref": "#/definitions/probePort" }
          }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RustFS chart values",
  "required": [
    "architecture",
    "replicaCount",
    "image",
    "auth",
    "persistence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "architecture": {
            "const": "standalone"
          }
        }
      },
      "then": {
        "properties": {
          "replicaCount": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "architecture": {
            "enum": [
              "distributed",
              "cluster"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "replicaCount": {
            "minimum": 4
          },
          "persistence": {
            "properties": {
              "enabled": {
                "const": true
              },
              "existingClaim": {
                "const": ""
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "replication": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "replication": {
            "properties": {
              "peers": {
                "minItems": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "bucket"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "buckets": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "site"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "localEndpoint": {
                      "minLength": 1
                    },
                    "buckets": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
