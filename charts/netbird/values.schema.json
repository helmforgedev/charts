{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "netbird Helm Chart Values",
  "description": "Values for the NetBird self-hosted control plane chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by parent charts.",
      "additionalProperties": true
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicaCount", "publicUrl", "authSecret", "containerPorts", "probes", "config", "auth", "store", "service"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "pattern": "^[0-9v][0-9A-Za-z._-]*$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "publicUrl": { "type": "string", "pattern": "^https?://[^\\s/]+(?:/.*)?$" },
        "authSecret": { "type": "string" },
        "disableAnonymousMetrics": { "type": "boolean" },
        "disableGeoliteUpdate": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "$ref": "#/definitions/env" },
        "envFrom": { "type": "array", "items": { "type": "object" } },
        "containerPorts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "stun", "metrics", "health"],
          "properties": {
            "http": { "$ref": "#/definitions/port" },
            "stun": { "$ref": "#/definitions/port" },
            "metrics": { "$ref": "#/definitions/port" },
            "health": { "$ref": "#/definitions/port" }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "existingSecretKey", "extraYaml"],
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 },
            "extraYaml": { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "localAuthDisabled", "signKeyRefreshEnabled", "owner"],
          "properties": {
            "issuer": { "type": "string", "pattern": "^https?://" },
            "localAuthDisabled": { "type": "boolean" },
            "signKeyRefreshEnabled": { "type": "boolean" },
            "owner": {
              "type": "object",
              "additionalProperties": false,
              "required": ["email", "password"],
              "properties": {
                "email": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "dsn", "encryptionKey"],
          "properties": {
            "engine": { "type": "string", "enum": ["", "sqlite", "postgres", "mysql"] },
            "dsn": { "type": "string" },
            "encryptionKey": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "httpPort", "stunPort", "metricsPort", "healthPort", "annotations", "ipFamilyPolicy", "ipFamilies"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "httpPort": { "$ref": "#/definitions/port" },
            "stunPort": { "$ref": "#/definitions/port" },
            "metricsPort": { "$ref": "#/definitions/port" },
            "healthPort": { "$ref": "#/definitions/port" },
            "annotations": { "type": "object" },
            "ipFamilyPolicy": { "type": "string", "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
            "ipFamilies": { "type": "array", "items": { "type": "string", "enum": ["IPv4", "IPv6"] }, "maxItems": 2, "uniqueItems": true }
          }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicaCount", "containerPorts", "auth", "securityContext", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "pattern": "^[0-9v][0-9A-Za-z._-]*$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "env": { "$ref": "#/definitions/env" },
        "envFrom": { "type": "array", "items": { "type": "object" } },
        "containerPorts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http"],
          "properties": { "http": { "$ref": "#/definitions/port" } }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clientId", "audience", "supportedScopes", "redirectUri", "silentRedirectUri", "tokenSource", "useAuth0"],
          "properties": {
            "clientId": { "type": "string", "minLength": 1 },
            "audience": { "type": "string", "minLength": 1 },
            "supportedScopes": { "type": "string", "minLength": 1 },
            "redirectUri": { "type": "string", "minLength": 1 },
            "silentRedirectUri": { "type": "string", "minLength": 1 },
            "tokenSource": { "type": "string", "enum": ["accessToken", "idToken"] },
            "useAuth0": { "type": "string", "enum": ["true", "false"] }
          }
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowPrivilegeEscalation", "capabilities", "readOnlyRootFilesystem", "runAsNonRoot", "seccompProfile"],
          "properties": {
            "allowPrivilegeEscalation": { "type": "boolean" },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": ["drop"],
              "properties": {
                "drop": { "type": "array", "items": { "type": "string" } },
                "add": { "type": "array", "items": { "type": "string" } }
              }
            },
            "readOnlyRootFilesystem": { "type": "boolean" },
            "runAsNonRoot": { "type": "boolean" },
            "runAsUser": { "type": "integer", "minimum": 0 },
            "runAsGroup": { "type": "integer", "minimum": 0 },
            "seccompProfile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] } }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port", "annotations", "ipFamilyPolicy", "ipFamilies"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "$ref": "#/definitions/port" },
            "annotations": { "type": "object" },
            "ipFamilyPolicy": { "type": "string", "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
            "ipFamilies": { "type": "array", "items": { "type": "string", "enum": ["IPv4", "IPv6"] }, "maxItems": 2, "uniqueItems": true }
          }
        }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "sqlite", "postgresql", "external"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "host", "port", "name", "username", "password", "existingSecret", "existingSecretPasswordKey", "sslMode", "dsn"],
          "properties": {
            "engine": { "type": "string", "enum": ["postgres", "mysql"] },
            "host": { "type": "string" },
            "port": { "$ref": "#/definitions/port" },
            "name": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
            "sslMode": { "type": "string", "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] },
            "dsn": { "type": "string" }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "architecture", "auth", "standalone"],
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string", "enum": ["standalone", "replication"] },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["database", "username", "password", "postgresPassword"],
          "properties": {
            "database": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "postgresPassword": { "type": "string" }
          }
        },
        "standalone": {
          "type": "object",
          "additionalProperties": true,
          "required": ["persistence"],
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "required": ["enabled", "size"],
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "$ref": "#/definitions/quantity" }
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClass", "accessModes", "existingClaim", "mountPath", "emptyDirSizeLimit"],
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "$ref": "#/definitions/quantity" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"] }, "minItems": 1 },
        "existingClaim": { "type": "string" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "emptyDirSizeLimit": { "$ref": "#/definitions/quantity" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array", "items": { "type": "object" } },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "httpRoutes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "httpRoutes": { "type": "array", "items": { "type": "object" } }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiVersion", "refreshInterval", "items"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "type": "string", "pattern": "^external-secrets\\.io/v" },
        "refreshInterval": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "type": "object" } }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "$ref": "#/definitions/quantity" },
            "memory": { "$ref": "#/definitions/quantity" },
            "ephemeral-storage": { "$ref": "#/definitions/quantity" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "$ref": "#/definitions/quantity" },
            "memory": { "$ref": "#/definitions/quantity" },
            "ephemeral-storage": { "$ref": "#/definitions/quantity" }
          }
        }
      }
    },
    "runtimeStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nginxVarSizeLimit", "nginxLogsSizeLimit", "nginxTmpSizeLimit", "nginxRunSizeLimit"],
      "properties": {
        "nginxVarSizeLimit": { "$ref": "#/definitions/quantity" },
        "nginxLogsSizeLimit": { "$ref": "#/definitions/quantity" },
        "nginxTmpSizeLimit": { "$ref": "#/definitions/quantity" },
        "nginxRunSizeLimit": { "$ref": "#/definitions/quantity" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fsGroup", "fsGroupChangePolicy"],
      "properties": {
        "fsGroup": { "type": "integer", "minimum": 0 },
        "fsGroupChangePolicy": { "type": "string", "enum": ["Always", "OnRootMismatch"] }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "capabilities", "readOnlyRootFilesystem", "runAsNonRoot", "seccompProfile"],
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": { "type": "array", "items": { "type": "string" } },
            "add": { "type": "array", "items": { "type": "string" } }
          }
        },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] } }
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "$ref": "#/definitions/boolean" },
        "minAvailable": { "$ref": "#/definitions/intOrPercentOrNull" },
        "maxUnavailable": { "$ref": "#/definitions/intOrPercentOrNull" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressFrom", "stunIngressFrom", "extraEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } },
        "stunIngressFrom": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "extraManifests": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "boolean": { "type": "boolean" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "quantity": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+|m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$" }
      ]
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "value": { "type": ["string", "number", "boolean"] },
          "valueFrom": { "type": "object" }
        },
        "oneOf": [
          { "required": ["value"] },
          { "required": ["valueFrom"] }
        ]
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drop"],
      "properties": {
        "drop": { "type": "array", "items": { "type": "string" } },
        "add": { "type": "array", "items": { "type": "string" } }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "capabilities", "readOnlyRootFilesystem", "runAsNonRoot", "seccompProfile"],
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "capabilities": { "$ref": "#/definitions/capabilities" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] } }
        }
      }
    },
    "intOrPercentOrNull": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(?:100|[0-9]{1,2})%$" },
        { "type": "null" }
      ]
    }
  }
}
