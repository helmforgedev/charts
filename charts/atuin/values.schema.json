{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Atuin Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "stable", "edge"] } },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "atuin": {
      "type": "object",
      "required": ["openRegistration", "path", "maxRecordSize", "logLevel"],
      "properties": {
        "openRegistration": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^$|^/[^/].*[^/]$|^/[^/]$" },
        "maxRecordSize": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "minLength": 1 },
        "fakeVersion": { "type": "string" },
        "registerWebhook": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "envFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "database": {
      "type": "object",
      "required": ["type", "existingSecret", "existingSecretKey"],
      "properties": {
        "type": { "enum": ["sqlite", "postgresql"] },
        "sqlite": {
          "type": "object",
          "required": ["path"],
          "properties": { "path": { "type": "string", "pattern": "^/config/" } }
        },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "ipFamilyPolicy": { "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
        "ipFamilies": { "type": "array", "items": { "enum": ["IPv4", "IPv6"] } }
      }
    },
    "ingress": { "type": "object" },
    "gatewayAPI": { "type": "object" },
    "metrics": { "type": "object" },
    "externalSecrets": { "type": "object" },
    "probes": { "type": "object" },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podDisruptionBudget": { "type": "object" },
    "autoscaling": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "postgresql": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraContainers": { "type": "array" },
    "extraInitContainers": { "type": "array" },
    "extraManifests": { "type": "array" }
  },
  "required": ["image", "replicaCount", "atuin", "database", "persistence", "service"]
}
