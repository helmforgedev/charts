{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Nextcloud chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string",
      "default": ""
    },
    "fullnameOverride": {
      "type": "string",
      "default": ""
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string",
          "default": "docker.io/library/nextcloud"
        },
        "tag": {
          "type": "string",
          "default": "34.0.4-apache",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-apache$"
        },
        "pullPolicy": {
          "type": "string",
          "default": "IfNotPresent",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {},
      "default": []
    },
    "nextcloud": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adminUser": {
          "type": "string",
          "default": "admin"
        },
        "adminPassword": {
          "type": "string",
          "default": ""
        },
        "existingSecret": {
          "type": "string",
          "default": ""
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "default": "admin-password"
        },
        "trustedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s/]+$"
          },
          "default": [
            "localhost"
          ],
          "minItems": 1
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "overwriteCliUrl": {
          "type": "string",
          "default": "http://localhost:8080"
        },
        "overwriteProtocol": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "http",
            "https"
          ]
        },
        "overwriteHost": {
          "type": "string",
          "default": ""
        },
        "defaultPhoneRegion": {
          "type": "string",
          "default": "US"
        },
        "maintenanceWindowStart": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 23
        }
      }
    },
    "php": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "memoryLimit": {
          "type": "string",
          "default": "512M"
        },
        "uploadLimit": {
          "type": "string",
          "default": "512M"
        }
      }
    },
    "cron": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interval": {
          "type": "integer",
          "default": 300,
          "minimum": 60
        },
        "initialDelay": {
          "type": "integer",
          "default": 300,
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "cpu": {
                  "type": "string",
                  "default": "25m"
                },
                "memory": {
                  "type": "string",
                  "default": "128Mi"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "cpu": {
                  "type": "string",
                  "default": "500m"
                },
                "memory": {
                  "type": "string",
                  "default": "512Mi"
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string",
              "default": "100m"
            },
            "memory": {
              "type": "string",
              "default": "512Mi"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string",
              "default": "2"
            },
            "memory": {
              "type": "string",
              "default": "1536Mi"
            }
          }
        }
      }
    },
    "initResources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string",
              "default": "25m"
            },
            "memory": {
              "type": "string",
              "default": "64Mi"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cpu": {
              "type": "string",
              "default": "500m"
            },
            "memory": {
              "type": "string",
              "default": "128Mi"
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean",
          "default": true
        },
        "runAsUser": {
          "type": "integer",
          "default": 33,
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "default": 33,
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "default": 33,
          "minimum": 1
        },
        "fsGroupChangePolicy": {
          "type": "string",
          "default": "OnRootMismatch"
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "default": "RuntimeDefault"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean",
          "default": false
        },
        "readOnlyRootFilesystem": {
          "type": "boolean",
          "default": true
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string",
                "default": "ALL"
              },
              "default": [
                "ALL"
              ]
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "existingClaim": {
          "type": "string",
          "default": ""
        },
        "storageClass": {
          "type": "string",
          "default": ""
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          },
          "default": [
            "ReadWriteOnce"
          ],
          "minItems": 1
        },
        "size": {
          "type": "string",
          "default": "10Gi"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "default": "ClusterIP",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "default": 80,
          "minimum": 1,
          "maximum": 65535
        },
        "ipFamilyPolicy": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ]
        },
        "ipFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "IPv4",
              "IPv6"
            ]
          },
          "default": [],
          "maxItems": 2
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "database": {
              "type": "string",
              "default": "nextcloud"
            },
            "username": {
              "type": "string",
              "default": "nextcloud"
            }
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": {
          "type": "string",
          "default": ""
        },
        "port": {
          "type": "integer",
          "default": 5432,
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "default": "nextcloud"
        },
        "username": {
          "type": "string",
          "default": "nextcloud"
        },
        "existingSecret": {
          "type": "string",
          "default": ""
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "default": "password"
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "architecture": {
          "type": "string",
          "default": "standalone",
          "enum": [
            "standalone"
          ]
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": {
          "type": "string",
          "default": ""
        },
        "port": {
          "type": "integer",
          "default": 6379,
          "minimum": 1,
          "maximum": 65535
        },
        "existingSecret": {
          "type": "string",
          "default": ""
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "default": "password"
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "tolerations": {
      "type": "array",
      "items": {},
      "default": []
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "default": 120,
      "minimum": 1
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "ingressClassName": {
          "type": "string",
          "default": ""
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {}
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "host": {
                "type": "string",
                "default": "nextcloud.example.com"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "path": {
                      "type": "string",
                      "default": "/"
                    },
                    "pathType": {
                      "type": "string",
                      "default": "Prefix"
                    }
                  }
                },
                "default": [
                  {
                    "path": "/",
                    "pathType": "Prefix"
                  }
                ]
              }
            }
          },
          "default": [
            {
              "host": "nextcloud.example.com",
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix"
                }
              ]
            }
          ]
        },
        "tls": {
          "type": "array",
          "items": {},
          "default": []
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "httpRoutes": {
          "type": "array",
          "items": {},
          "default": []
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "refreshInterval": {
          "type": "string",
          "default": "1h"
        },
        "items": {
          "type": "array",
          "items": {},
          "default": []
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "host": {
          "type": "string",
          "default": ""
        },
        "port": {
          "type": "integer",
          "default": 587,
          "minimum": 1,
          "maximum": 65535
        },
        "secure": {
          "type": "string",
          "default": "tls"
        },
        "fromAddress": {
          "type": "string",
          "default": "nextcloud"
        },
        "domain": {
          "type": "string",
          "default": "example.com"
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "existingSecret": {
          "type": "string",
          "default": ""
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "default": "password"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "extraIngress": {
          "type": "array",
          "items": {},
          "default": []
        },
        "extraEgress": {
          "type": "array",
          "items": {},
          "default": []
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "schedule": {
          "type": "string",
          "default": "0 2 * * *"
        },
        "suspend": {
          "type": "boolean",
          "default": false
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "default": 7200,
          "minimum": 1
        },
        "quiesceTimeout": {
          "type": "integer",
          "default": 180,
          "minimum": 1
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "default": 3,
          "minimum": 1
        },
        "databaseImage": {
          "type": "string",
          "default": "docker.io/library/postgres:18.6-trixie"
        },
        "s3Image": {
          "type": "string",
          "default": "public.ecr.aws/aws-cli/aws-cli:2.36.43"
        },
        "workspaceSize": {
          "type": "string",
          "default": "20Gi"
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "cpu": {
                  "type": "string",
                  "default": "100m"
                },
                "memory": {
                  "type": "string",
                  "default": "256Mi"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "cpu": {
                  "type": "string",
                  "default": "2"
                },
                "memory": {
                  "type": "string",
                  "default": "1Gi"
                }
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "endpoint": {
              "type": "string",
              "default": ""
            },
            "bucket": {
              "type": "string",
              "default": ""
            },
            "prefix": {
              "type": "string",
              "default": "nextcloud"
            },
            "region": {
              "type": "string",
              "default": "us-east-1"
            },
            "existingSecret": {
              "type": "string",
              "default": ""
            },
            "existingSecretAccessKeyKey": {
              "type": "string",
              "default": "access-key"
            },
            "existingSecretSecretKeyKey": {
              "type": "string",
              "default": "secret-key"
            }
          }
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "backupPath": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
