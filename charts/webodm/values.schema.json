{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "WebODM Helm Chart Values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/.+"},
        "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "main", "master", "dev", "nightly", "edge", "stable"]}},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "webodm": {
      "type": "object",
      "required": ["host", "debug", "existingSecret", "existingSecretKeyKey", "existingSecretProcessorTokenKey", "secretKey", "processorToken", "extraEnv", "extraEnvFrom"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "debug": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "existingSecretKeyKey": {"type": "string", "minLength": 1},
        "existingSecretProcessorTokenKey": {"type": "string", "minLength": 1},
        "secretKey": {"type": "string"},
        "processorToken": {"type": "string"},
        "extraEnv": {"type": "array", "items": {"type": "object"}},
        "extraEnvFrom": {"type": "array", "items": {"type": "object"}}
      }
    },
    "web": {
      "type": "object",
      "required": ["containerPort", "concurrency", "resources", "startupFailureThreshold", "startupPeriodSeconds", "terminationGracePeriodSeconds"],
      "properties": {
        "containerPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "concurrency": {"type": "integer", "minimum": 1},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {"cpu": {"type": ["string", "number"]}, "memory": {"type": "string"}}
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {"cpu": {"type": ["string", "number"]}, "memory": {"type": "string"}}
            }
          }
        },
        "startupFailureThreshold": {"type": "integer", "minimum": 1},
        "startupPeriodSeconds": {"type": "integer", "minimum": 1},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30}
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount", "concurrency", "resources", "terminationGracePeriodSeconds"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 2},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {"cpu": {"type": ["string", "number"]}, "memory": {"type": "string"}}
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {"cpu": {"type": ["string", "number"]}, "memory": {"type": "string"}}
            }
          }
        },
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 60}
      }
    },
    "processing": {
      "type": "object",
      "required": ["enabled", "containerPort", "image", "gpu", "label", "parallelQueueProcessing", "maxImages", "maxConcurrency", "maxRuntime", "cleanupTasksAfter", "cleanupUploadsAfter", "resources", "terminationGracePeriodSeconds", "persistence", "tmpSizeLimit"],
      "properties": {
        "enabled": {"type": "boolean"},
        "containerPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/.+"},
            "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "main", "master", "dev", "nightly", "edge", "stable"]}},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "gpu": {
          "type": "object",
          "required": ["enabled", "image", "count", "runtimeClassName", "nodeSelector", "tolerations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {
              "type": "object",
              "required": ["repository", "tag", "digest", "pullPolicy"],
              "properties": {
                "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/.+"},
                "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "main", "master", "dev", "nightly", "edge", "stable"]}},
                "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
              }
            },
            "count": {"type": "integer", "minimum": 1},
            "runtimeClassName": {"type": "string"},
            "nodeSelector": {"type": "object"},
            "tolerations": {"type": "array", "items": {"type": "object"}}
          }
        },
        "label": {"type": "string", "minLength": 1},
        "parallelQueueProcessing": {"type": "integer", "minimum": 1},
        "maxImages": {"type": "integer", "minimum": 0},
        "maxConcurrency": {"type": "integer", "minimum": 0},
        "maxRuntime": {"type": "integer", "minimum": 0},
        "cleanupTasksAfter": {"type": "integer", "minimum": 1},
        "cleanupUploadsAfter": {"type": "integer", "minimum": 1},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory", "ephemeral-storage"],
              "properties": {
                "cpu": {"type": ["string", "number"]},
                "memory": {"type": "string"},
                "ephemeral-storage": {"type": "string"}
              }
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory", "ephemeral-storage"],
              "properties": {
                "cpu": {"type": ["string", "number"]},
                "memory": {"type": "string"},
                "ephemeral-storage": {"type": "string"}
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 60},
        "persistence": {
          "type": "object",
          "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "existingClaim": {"type": "string"},
            "storageClass": {"type": "string"},
            "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}},
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"},
            "retain": {"type": "boolean"},
            "annotations": {"type": "object"}
          }
        },
        "tmpSizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"},
        "retain": {"type": "boolean"},
        "annotations": {"type": "object"}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "annotations", "ipFamilyPolicy", "ipFamilies"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"},
        "ipFamilyPolicy": {"type": "string", "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"]},
        "ipFamilies": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["IPv4", "IPv6"]}}
      }
    },
    "processingService": {
      "type": "object",
      "required": ["port", "annotations", "ipFamilyPolicy", "ipFamilies"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"},
        "ipFamilyPolicy": {"type": "string", "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"]},
        "ipFamilies": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["IPv4", "IPv6"]}}
      }
    },
    "oidc": {
      "type": "object",
      "required": ["enabled", "name", "clientId", "existingSecret", "existingSecretClientSecretKey", "authEndpoint", "tokenEndpoint", "userinfoEndpoint", "icon", "allowedEmails", "updateProfile", "customScopes", "groupClaims", "createGroups", "ignoreGroups"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "clientId": {"type": "string"},
        "existingSecret": {"type": "string"},
        "existingSecretClientSecretKey": {"type": "string", "minLength": 1},
        "authEndpoint": {"type": "string"},
        "tokenEndpoint": {"type": "string"},
        "userinfoEndpoint": {"type": "string"},
        "icon": {"type": "string"},
        "allowedEmails": {"type": "array", "items": {"type": "string"}},
        "updateProfile": {"type": "boolean"},
        "customScopes": {"type": "array", "items": {"type": "string"}},
        "groupClaims": {"type": "array", "items": {"type": "string"}},
        "createGroups": {"type": "boolean"},
        "ignoreGroups": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressClassName": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "tls": {"type": "array", "items": {"type": "object"}}
      }
    },
    "gatewayAPI": {
      "type": "object",
      "required": ["enabled", "parentRefs", "hostnames", "annotations", "rules"],
      "properties": {
        "enabled": {"type": "boolean"},
        "parentRefs": {"type": "array", "items": {"type": "object"}},
        "hostnames": {"type": "array", "items": {"type": "string"}},
        "annotations": {"type": "object"},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressFrom", "extraEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFrom": {"type": "array", "items": {"type": "object"}},
        "extraEgress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    },
    "externalSecrets": {
      "type": "object",
      "required": ["enabled", "refreshInterval", "items"],
      "properties": {
        "enabled": {"type": "boolean"},
        "refreshInterval": {"type": "string", "minLength": 1},
        "items": {"type": "array", "items": {"type": "object"}}
      }
    },
    "externalDatabase": {
      "type": "object",
      "required": ["host", "port", "database", "username", "existingSecret", "existingSecretPasswordKey"],
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "existingSecret": {"type": "string"},
        "existingSecretPasswordKey": {"type": "string", "minLength": 1}
      }
    },
    "externalRedis": {
      "type": "object",
      "required": ["host", "port", "database", "existingSecret", "existingSecretPasswordKey"],
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "integer", "minimum": 0, "maximum": 15},
        "existingSecret": {"type": "string"},
        "existingSecretPasswordKey": {"type": "string", "minLength": 1}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "image", "architecture", "auth", "initdb", "standalone"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": true,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/.+"},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "architecture": {"type": "string", "enum": ["standalone", "replication"]},
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["database", "username", "password", "existingSecret", "existingSecretUserPasswordKey"],
          "properties": {
            "database": {"type": "string", "minLength": 1},
            "username": {"type": "string", "minLength": 1},
            "password": {"type": "string"},
            "existingSecret": {"type": "string"},
            "existingSecretUserPasswordKey": {"type": "string", "minLength": 1}
          }
        },
        "initdb": {
          "type": "object",
          "additionalProperties": true,
          "required": ["runDefaultScript", "scripts"],
          "properties": {
            "runDefaultScript": {"type": "boolean"},
            "scripts": {
              "type": "object",
              "required": ["10-webodm-postgis.sql"],
              "properties": {"10-webodm-postgis.sql": {"type": "string", "minLength": 1}}
            }
          }
        },
        "standalone": {
          "type": "object",
          "additionalProperties": true,
          "required": ["persistence"],
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "required": ["enabled", "size"],
              "properties": {
                "enabled": {"type": "boolean"},
                "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}
              }
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "architecture", "auth", "standalone"],
      "properties": {
        "enabled": {"type": "boolean"},
        "architecture": {"type": "string", "enum": ["standalone", "replication"]},
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "password", "existingSecret", "existingSecretPasswordKey"],
          "properties": {
            "enabled": {"type": "boolean"},
            "password": {"type": "string"},
            "existingSecret": {"type": "string"},
            "existingSecretPasswordKey": {"type": "string", "minLength": 1}
          }
        },
        "standalone": {
          "type": "object",
          "additionalProperties": true,
          "required": ["persistence"],
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "required": ["enabled", "size"],
              "properties": {
                "enabled": {"type": "boolean"},
                "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}
              }
            }
          }
        }
      }
    },
    "podLabels": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podSecurityContext": {
      "type": "object",
      "required": ["seccompProfile"],
      "properties": {
        "seccompProfile": {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"]}}
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["runAsUser", "runAsNonRoot", "allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "runAsUser": {"type": "integer", "minimum": 0},
        "runAsNonRoot": {"type": "boolean"},
        "allowPrivilegeEscalation": {"type": "boolean"},
        "readOnlyRootFilesystem": {"type": "boolean"},
        "capabilities": {
          "type": "object",
          "required": ["drop", "add"],
          "properties": {
            "drop": {"type": "array", "items": {"type": "string"}},
            "add": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
    "priorityClassName": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"},
        "automountServiceAccountToken": {"type": "boolean"}
      }
    }
  },
  "required": ["image", "webodm", "web", "worker", "processing", "persistence", "service", "processingService", "oidc", "ingress", "gatewayAPI", "networkPolicy", "pdb", "externalSecrets", "externalDatabase", "externalRedis", "postgresql", "redis", "serviceAccount"],
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": ["string", "number"]},
            "memory": {"type": "string"}
          }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": ["string", "number"]},
            "memory": {"type": "string"}
          }
        }
      }
    },
    "processingResources": {
      "type": "object",
      "required": ["cpu", "memory", "ephemeral-storage"],
      "properties": {
        "cpu": {"type": ["string", "number"]},
        "memory": {"type": "string"},
        "ephemeral-storage": {"type": "string"}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/.+"},
        "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "main", "master", "dev", "nightly", "edge", "stable"]}},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"},
        "retain": {"type": "boolean"},
        "annotations": {"type": "object"}
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"},
        "ipFamilyPolicy": {"type": "string", "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"]},
        "ipFamilies": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["IPv4", "IPv6"]}}
      }
    }
  }
}
