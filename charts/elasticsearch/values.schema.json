{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Elasticsearch Helm Chart Values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object", "additionalProperties": true },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "clusterProfile": { "type": "string", "enum": ["dev", "staging", "production-ha"] },
    "clusterName": { "type": "string", "minLength": 1 },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "containerPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "transport"],
      "properties": {
        "http": { "$ref": "#/definitions/port" },
        "transport": { "$ref": "#/definitions/port" }
      }
    },
    "master": { "$ref": "#/definitions/nodeRole" },
    "data": { "$ref": "#/definitions/nodeRole" },
    "coordinating": { "$ref": "#/definitions/nodeRole" },
    "security": {
      "type": "object",
      "required": ["enabled", "tls", "existingTlsSecret", "existingCredentialsSecret", "generatePasswords"],
      "properties": {
        "enabled": { "type": "boolean" },
        "tls": { "type": "object" },
        "existingTlsSecret": { "type": "string" },
        "existingCredentialsSecret": { "type": "string" },
        "generatePasswords": { "type": "boolean" }
      }
    },
    "backup": { "type": "object" },
    "ilm": { "type": "object" },
    "monitoring": {
      "type": "object",
      "required": ["enabled", "containerPort", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "containerPort": { "$ref": "#/definitions/port" },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "type": "object" },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" },
            "annotations": { "type": "object" },
            "ipFamilyPolicy": { "$ref": "#/definitions/ipFamilyPolicy" },
            "ipFamilies": { "$ref": "#/definitions/ipFamilies" }
          }
        },
        "serviceMonitor": { "type": "object" },
        "prometheusRule": { "type": "object" },
        "grafana": { "type": "object" }
      }
    },
    "kibana": {
      "type": "object",
      "required": ["enabled", "containerPort", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "containerPort": { "$ref": "#/definitions/port" },
        "service": { "$ref": "#/definitions/service" },
        "ingress": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
      }
    },
    "service": { "$ref": "#/definitions/service" },
    "ingress": { "type": "object" },
    "serviceAccount": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "sysctlInit": { "type": "object" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "extraConfig": { "type": "object" },
    "dataTiers": { "type": "object" },
    "certManager": { "type": "object" },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "httpRoutes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "httpRoutes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "labels": { "type": "object" },
              "hostnames": { "type": "array", "items": { "type": "string" } },
              "parentRefs": { "type": "array", "items": { "type": "object" } },
              "annotations": { "type": "object" },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "matches": { "type": "array", "items": { "type": "object" } },
                    "filters": { "type": "array", "items": { "type": "object" } },
                    "backendRefs": { "type": "array", "items": { "type": "object" } },
                    "omitDefaultBackend": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "refreshInterval", "items"],
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["spec"],
            "properties": {
              "name": { "type": "string" },
              "fullnameOverride": { "type": "string" },
              "labels": { "type": "object" },
              "annotations": { "type": "object" },
              "spec": {
                "type": "object",
                "properties": {
                  "refreshInterval": { "type": "string" },
                  "secretStoreRef": { "type": "object" },
                  "target": { "type": "object" },
                  "data": { "type": "array", "items": { "type": "object" } },
                  "dataFrom": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest"] } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nodeRole": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": ["integer", "null"], "minimum": 0 },
        "heapSize": { "type": ["string", "null"] },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "persistence": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" },
        "annotations": { "type": "object" },
        "ipFamilyPolicy": { "$ref": "#/definitions/ipFamilyPolicy" },
        "ipFamilies": { "$ref": "#/definitions/ipFamilies" }
      }
    },
    "ipFamilyPolicy": { "type": ["string", "null"], "enum": [null, "SingleStack", "PreferDualStack", "RequireDualStack"] },
    "ipFamilies": { "type": "array", "items": { "type": "string", "enum": ["IPv4", "IPv6"] }, "maxItems": 2 },
    "probe": {
      "type": "object",
      "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
