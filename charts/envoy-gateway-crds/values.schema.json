{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Envoy Gateway CRDs Helm Chart Values",
  "description": "Values for the Envoy Gateway CRD lifecycle chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gateway-api-crds": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved values namespace for the internal Gateway API CRD subchart"
    },
    "envoy-gateway-extension-crds": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved values namespace for the internal Envoy Gateway CRD subchart"
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gatewayAPI", "envoyGateway"],
      "properties": {
        "gatewayAPI": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Install Gateway API v1.6.1 Experimental CRDs"
            }
          }
        },
        "envoyGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Install Envoy Gateway v1.9.0 extension CRDs"
            }
          }
        }
      }
    },
    "safeUpgradePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management"],
      "properties": {
        "management": {
          "type": "string",
          "enum": ["managed", "external", "disabled"],
          "default": "managed",
          "description": "Ownership mode for the Gateway API safe-upgrade policy and binding"
        }
      }
    },
    "commonLabels": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional labels for Helm-managed resources"
    }
  },
  "required": ["crds", "safeUpgradePolicy", "commonLabels"]
}
