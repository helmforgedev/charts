{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSign chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object", "additionalProperties": true },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "autoscaling", "podDisruptionBudget", "image", "resources", "extraEnv"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
            "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"], "minimum": 0 },
            "maxUnavailable": { "type": ["integer", "string", "null"], "minimum": 0 }
          }
        },
        "image": { "$ref": "#/$defs/image" },
        "resources": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "resources", "extraEnv"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "resources": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicUrl", "apiUrl", "appId", "appName"],
      "properties": {
        "publicUrl": { "type": "string", "pattern": "^https?://" },
        "apiUrl": { "type": "string", "pattern": "^https?://.+/app/?$" },
        "appId": { "type": "string", "minLength": 1 },
        "appName": { "type": "string", "minLength": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "masterKeyKey",
        "masterKey",
        "pfxBase64Key",
        "pfxBase64",
        "pfxPassphraseKey",
        "pfxPassphrase",
        "smtpPasswordKey",
        "smtpPassword",
        "objectStorageAccessKeyIdKey",
        "objectStorageAccessKeyId",
        "objectStorageSecretAccessKeyKey",
        "objectStorageSecretAccessKey"
      ],
      "properties": {
        "existingSecret": { "type": "string" },
        "masterKeyKey": { "$ref": "#/$defs/secretKey" },
        "masterKey": { "type": "string" },
        "pfxBase64Key": { "$ref": "#/$defs/secretKey" },
        "pfxBase64": { "type": "string" },
        "pfxPassphraseKey": { "$ref": "#/$defs/secretKey" },
        "pfxPassphrase": { "type": "string" },
        "smtpPasswordKey": { "$ref": "#/$defs/secretKey" },
        "smtpPassword": { "type": "string" },
        "objectStorageAccessKeyIdKey": { "$ref": "#/$defs/secretKey" },
        "objectStorageAccessKeyId": { "type": "string" },
        "objectStorageSecretAccessKeyKey": { "$ref": "#/$defs/secretKey" },
        "objectStorageSecretAccessKey": { "type": "string" }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "port", "username", "fromAddress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "fromAddress": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "persistence", "s3"],
      "properties": {
        "type": { "type": "string", "enum": ["local", "s3"] },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
            },
            "size": { "type": "string", "minLength": 1 },
            "retain": { "type": "boolean" }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket", "endpoint", "baseUrl", "region"],
          "properties": {
            "bucket": { "type": "string" },
            "endpoint": { "type": "string" },
            "baseUrl": { "type": "string" },
            "region": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "externalMongodb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "uri", "existingSecret", "existingSecretUriKey", "port", "networkPolicyPeers"],
      "properties": {
        "enabled": { "type": "boolean" },
        "uri": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretUriKey": { "$ref": "#/$defs/secretKey" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "networkPolicyPeers": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "frontendPort", "backendPort", "annotations", "ipFamilyPolicy", "ipFamilies"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "frontendPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "backendPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "ipFamilyPolicy": { "type": "string", "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
        "ipFamilies": { "type": "array", "items": { "type": "string", "enum": ["IPv4", "IPv6"] }, "maxItems": 2 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "frontendHost", "apiHost", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "frontendHost": { "type": "string" },
        "apiHost": { "type": "string" },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "parentRefs", "frontendHostnames", "apiHostnames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array", "items": { "type": "object" } },
        "frontendHostnames": { "type": "array", "items": { "type": "string" } },
        "apiHostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "backend"],
      "properties": {
        "frontend": { "$ref": "#/$defs/componentProbes" },
        "backend": { "$ref": "#/$defs/componentProbes" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "extraIngress", "extraEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "extraIngress": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "runtimeStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeLimit"],
      "properties": {
        "sizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiVersion", "refreshInterval", "secretStoreRef", "target", "items"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "type": "string", "enum": ["external-secrets.io/v1", "external-secrets.io/v1beta1"] },
        "refreshInterval": { "type": "string", "minLength": 1 },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["creationPolicy"],
          "properties": {
            "creationPolicy": { "type": "string", "enum": ["Owner", "Orphan", "Merge", "None"] }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretKey", "remoteRef"],
            "properties": {
              "secretKey": { "$ref": "#/$defs/secretKey" },
              "remoteRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key"],
                "properties": {
                  "key": { "type": "string", "minLength": 1 },
                  "property": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "architecture", "auth"],
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string", "enum": ["standalone", "replicaset"] },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "rootUser", "rootPassword"],
          "properties": {
            "enabled": { "const": true },
            "rootUser": { "type": "string", "minLength": 1 },
            "rootPassword": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$" }
          }
        }
      }
    }
  },
  "$defs": {
    "secretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "componentProbes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/$defs/probe" },
        "readiness": { "$ref": "#/$defs/probe" },
        "liveness": { "$ref": "#/$defs/probe" }
      }
    }
  }
}
