    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^ /]+/?$"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3
        },
        "password": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 16,
              "maxLength": 32
            }
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {}
        },
        "egressIsolation": {
          "type": "boolean"
        },
        "dnsEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "namespaceSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kubernetes.io/metadata.name": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "podSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "k8s-app": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {}
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "passwordSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "caSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      }
