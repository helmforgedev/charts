{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": true
    },
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {},
      "description": "Registry credentials for a private mirror."
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "description": "Additional environment entries; chart-managed security variables cannot be overridden."
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {}
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "description": "Kubernetes Service type."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service HTTP port."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {},
          "description": "Service annotations."
        },
        "ipFamilyPolicy": {
          "type": "string",
          "enum": [
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ],
          "description": "Service IP family policy; empty uses cluster default."
        },
        "ipFamilies": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IPv4",
              "IPv6"
            ]
          },
          "description": "Requested address families; RequireDualStack needs a dual-stack cluster."
        }
      },
      "description": "Service."
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Ingress. TLS is configured through ingress.tls."
        },
        "ingressClassName": {
          "type": "string",
          "description": "Ingress controller class; empty omits the field."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {},
          "description": "Annotations."
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "paths"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          },
          "description": "Host/path rules; at least one explicit host is required when enabled."
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hosts",
              "secretName"
            ],
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "description": "TLS host/Secret entries."
        }
      },
      "description": "Ingress."
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canonical Gateway API HTTPRoute configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "httpRoutes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "parentRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "namespace": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "sectionName": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  }
                }
              },
              "hostnames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "Exact",
                                  "PathPrefix",
                                  "RegularExpression"
                                ]
                              },
                              "value": {
                                "type": "string"
                              }
                            }
                          },
                          "headers": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "queryParams": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "method": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "filters": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "backendRefs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "namespace": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          },
                          "weight": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "filters": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "omitDefaultBackend": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enabled."
        },
        "refreshInterval": {
          "type": "string",
          "description": "Default operator refresh interval."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "spec"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "fullnameOverride": {
                "type": "string"
              },
              "labels": {
                "type": "object"
              },
              "annotations": {
                "type": "object"
              },
              "spec": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "description": "Items."
        }
      },
      "description": "External Secrets."
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 5
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 5
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 5
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 5
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 5
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 5
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
