          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
