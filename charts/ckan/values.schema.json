{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CKAN Helm Chart Values",
  "description": "Values for the CKAN open data portal chart.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object", "additionalProperties": true },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "stable", "main", "master", "edge"] } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "ckan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containerPort", "uwsgiProcesses", "uwsgiHarakiri", "siteUrl", "siteTitle", "sysadminName", "sysadminEmail", "sysadminPassword", "existingSecret", "existingSecretPasswordKey", "existingSecretSessionKey", "existingSecretJwtKey", "sessionSecret", "jwtSecret", "plugins", "replicaCount", "extraEnv"],
      "properties": {
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "uwsgiProcesses": { "type": "integer", "minimum": 1 },
        "uwsgiHarakiri": { "type": "integer", "minimum": 1 },
        "siteUrl": { "type": "string", "format": "uri" },
        "siteTitle": { "type": "string", "minLength": 1 },
        "sysadminName": { "type": "string", "minLength": 1 },
        "sysadminEmail": { "type": "string", "minLength": 1 },
        "sysadminPassword": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
        "existingSecretSessionKey": { "type": "string", "minLength": 1 },
        "existingSecretJwtKey": { "type": "string", "minLength": 1 },
        "sessionSecret": { "type": "string" },
        "jwtSecret": { "type": "string" },
        "plugins": { "type": "string", "minLength": 1 },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "extraEnv": { "type": "array", "items": { "type": "object" } }
      }
    },
    "datapusher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicaCount", "port", "resources", "podSecurityContext", "securityContext", "podLabels", "podAnnotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "stable", "main", "master", "edge"] } },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object", "properties": { "fsGroup": { "type": "integer" }, "fsGroupChangePolicy": { "type": "string" }, "seccompProfile": { "type": "object", "properties": { "type": { "type": "string" } } } } },
        "securityContext": { "type": "object", "properties": { "allowPrivilegeEscalation": { "type": "boolean" }, "capabilities": { "type": "object", "properties": { "drop": { "type": "array", "items": { "type": "string" } } } }, "readOnlyRootFilesystem": { "type": "boolean" }, "runAsNonRoot": { "type": "boolean" }, "runAsUser": { "type": "integer" }, "runAsGroup": { "type": "integer" } } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podAnnotations": { "type": "object" }
      }
    },
    "solr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "port", "persistence", "resources", "podSecurityContext", "securityContext", "externalUrl"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "stable", "main", "master", "edge"] } },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size", "storageClass", "accessModes"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string" },
            "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object", "properties": { "fsGroup": { "type": "integer" }, "fsGroupChangePolicy": { "type": "string" }, "seccompProfile": { "type": "object", "properties": { "type": { "type": "string" } } } } },
        "securityContext": { "type": "object", "properties": { "allowPrivilegeEscalation": { "type": "boolean" }, "capabilities": { "type": "object", "properties": { "drop": { "type": "array", "items": { "type": "string" } } } }, "readOnlyRootFilesystem": { "type": "boolean" }, "runAsNonRoot": { "type": "boolean" }, "runAsUser": { "type": "integer" }, "runAsGroup": { "type": "integer" } } },
        "externalUrl": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external"],
      "properties": {
        "mode": { "type": "string", "enum": ["subchart", "external"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "ckanDatabase", "datastoreDatabase", "username", "password", "datastoreReadUsername", "datastoreReadPassword", "existingSecret", "existingSecretPasswordKey", "existingSecretDatastoreReadPasswordKey", "sslMode"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "ckanDatabase": { "type": "string", "minLength": 1 },
            "datastoreDatabase": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "datastoreReadUsername": { "type": "string", "minLength": 1 },
            "datastoreReadPassword": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
            "existingSecretDatastoreReadPasswordKey": { "type": "string", "minLength": 1 },
            "sslMode": { "type": "string", "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }
          }
        }
      }
    },
    "redisConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external"],
      "properties": {
        "mode": { "type": "string", "enum": ["subchart", "external"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "database", "tls", "sslCertReqs", "sslCaCerts", "password", "existingSecret", "existingSecretPasswordKey"],
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "integer", "minimum": 0 },
            "tls": { "type": "boolean" },
            "sslCertReqs": { "type": "string", "enum": ["required", "optional", "none"] },
            "sslCaCerts": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClass", "accessModes", "existingClaim"],
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "existingClaim": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array", "items": { "type": "object" } },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness", "startup"],
      "properties": {
        "liveness": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "httpGet": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string" }, "port": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } } },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 }, "periodSeconds": { "type": "integer", "minimum": 1 }, "timeoutSeconds": { "type": "integer", "minimum": 1 }, "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "readiness": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "httpGet": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string" }, "port": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } } },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 }, "periodSeconds": { "type": "integer", "minimum": 1 }, "timeoutSeconds": { "type": "integer", "minimum": 1 }, "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "startup": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "tcpSocket": { "type": "object", "additionalProperties": false, "properties": { "port": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } } },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 }, "periodSeconds": { "type": "integer", "minimum": 1 }, "timeoutSeconds": { "type": "integer", "minimum": 1 }, "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressFrom", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } },
        "egress": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schedule", "suspend", "concurrencyPolicy", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "backoffLimit", "archivePrefix", "images", "resources", "podSecurityContext", "securityContext", "s3", "database"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "archivePrefix": { "type": "string", "minLength": 1 },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgresql", "uploader"],
          "properties": {
            "postgresql": { "type": "string", "minLength": 1 },
            "uploader": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object", "properties": { "fsGroup": { "type": "integer" }, "fsGroupChangePolicy": { "type": "string" }, "seccompProfile": { "type": "object", "properties": { "type": { "type": "string" } } } } },
        "securityContext": { "type": "object", "properties": { "allowPrivilegeEscalation": { "type": "boolean" }, "capabilities": { "type": "object", "properties": { "drop": { "type": "array", "items": { "type": "string" } } } }, "readOnlyRootFilesystem": { "type": "boolean" }, "runAsNonRoot": { "type": "boolean" }, "runAsUser": { "type": "integer" }, "runAsGroup": { "type": "integer" } } },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "bucket", "prefix", "createBucketIfNotExists", "existingSecret", "existingSecretAccessKeyKey", "existingSecretSecretKeyKey", "accessKey", "secretKey"],
          "properties": {
            "endpoint": { "type": "string" },
            "bucket": { "type": "string" },
            "prefix": { "type": "string" },
            "createBucketIfNotExists": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "existingSecretAccessKeyKey": { "type": "string", "minLength": 1 },
            "existingSecretSecretKeyKey": { "type": "string", "minLength": 1 },
            "accessKey": { "type": "string" },
            "secretKey": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "name", "username", "password", "existingSecret", "existingSecretPasswordKey", "postgresDumpArgs"],
          "properties": {
            "host": { "type": "string" },
            "port": { "oneOf": [{ "type": "string" }, { "type": "integer", "minimum": 1, "maximum": 65535 }] },
            "name": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
            "postgresDumpArgs": { "type": "string" }
          }
        }
      }
    },
    "podSecurityContext": { "type": "object", "properties": { "fsGroup": { "type": "integer" }, "fsGroupChangePolicy": { "type": "string" }, "seccompProfile": { "type": "object", "properties": { "type": { "type": "string" } } } } },
    "securityContext": { "type": "object", "properties": { "allowPrivilegeEscalation": { "type": "boolean" }, "capabilities": { "type": "object", "properties": { "drop": { "type": "array", "items": { "type": "string" } } } }, "readOnlyRootFilesystem": { "type": "boolean" }, "runAsNonRoot": { "type": "boolean" }, "runAsUser": { "type": "integer" }, "runAsGroup": { "type": "integer" } } },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object" },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "extraManifests": { "type": "array", "items": { "type": "object" } },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string", "enum": ["standalone", "replication"] },
        "startupProbe": { "type": "object", "additionalProperties": true, "properties": { "initialDelaySeconds": { "type": "integer", "minimum": 0 } } },
        "readinessProbe": { "type": "object", "additionalProperties": true, "properties": { "initialDelaySeconds": { "type": "integer", "minimum": 0 } } },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "database": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretUserPasswordKey": { "type": "string" }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string", "enum": ["standalone", "replication"] },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "stable", "main", "master", "edge"] } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "httpGet": { "type": "object" },
        "tcpSocket": { "type": "object" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        { "required": ["httpGet"], "not": { "required": ["tcpSocket"] } },
        { "required": ["tcpSocket"], "not": { "required": ["httpGet"] } }
      ]
    }
  }
}
