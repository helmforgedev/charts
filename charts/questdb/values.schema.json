{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "questdb", "persistence", "serviceAccount", "service", "metrics", "ingress", "gatewayAPI", "externalSecrets", "probes", "resources", "podSecurityContext", "securityContext", "networkPolicy"],
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object"},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "pullPolicy"], "properties": {"repository": {"const": "docker.io/questdb/questdb"}, "tag": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+@sha256:[a-f0-9]{64}$"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "questdb": {"type": "object", "additionalProperties": false, "required": ["pgUser", "httpUser", "existingSecret", "pgPasswordKey", "httpPasswordKey", "serverConfig", "extraEnv", "envFrom"], "properties": {"pgUser": {"type": "string", "minLength": 1}, "httpUser": {"type": "string", "minLength": 1}, "existingSecret": {"type": "string"}, "pgPasswordKey": {"type": "string", "minLength": 1}, "httpPasswordKey": {"type": "string", "minLength": 1}, "serverConfig": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}}, "extraEnv": {"type": "array", "items": {"type": "object"}}, "envFrom": {"type": "array", "items": {"type": "object"}}}},
    "persistence": {"$ref": "#/$defs/persistence"},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["create", "name", "annotations", "automountServiceAccountToken"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"type": "object"}, "automountServiceAccountToken": {"type": "boolean"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["type", "annotations", "pgWireEnabled", "ilpTcpEnabled", "ipFamilyPolicy", "ipFamilies"], "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "annotations": {"type": "object"}, "pgWireEnabled": {"type": "boolean"}, "ilpTcpEnabled": {"type": "boolean"}, "ipFamilyPolicy": {"type": "string"}, "ipFamilies": {"type": "array", "items": {"enum": ["IPv4", "IPv6"]}}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["enabled", "annotations", "serviceMonitor"], "properties": {"enabled": {"type": "boolean"}, "annotations": {"type": "object"}, "serviceMonitor": {"type": "object", "additionalProperties": false, "required": ["enabled", "interval", "scrapeTimeout", "labels"], "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string"}, "scrapeTimeout": {"type": "string"}, "labels": {"type": "object"}}}}},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"], "properties": {"enabled": {"type": "boolean"}, "ingressClassName": {"type": "string"}, "annotations": {"type": "object"}, "hosts": {"type": "array"}, "tls": {"type": "array"}}},
    "gatewayAPI": {"type": "object", "additionalProperties": false, "required": ["enabled", "httpRoutes"], "properties": {"enabled": {"type": "boolean"}, "httpRoutes": {"type": "array"}}},
    "externalSecrets": {"type": "object", "additionalProperties": false, "required": ["enabled", "refreshInterval", "items"], "properties": {"enabled": {"type": "boolean"}, "refreshInterval": {"type": "string"}, "items": {"type": "array"}}},
    "probes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/probe"}},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "updateStrategy": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "podDisruptionBudget": {"type": "object", "additionalProperties": false, "required": ["enabled", "minAvailable"], "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^(100|[0-9]{1,2})%$"}]}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "httpFrom", "pgWireFrom", "ilpTcpFrom", "metricsFrom", "allowDNS", "extraEgress"], "properties": {"enabled": {"type": "boolean"}, "httpFrom": {"type": "array"}, "pgWireFrom": {"type": "array"}, "ilpTcpFrom": {"type": "array"}, "metricsFrom": {"type": "array"}, "allowDNS": {"type": "boolean"}, "extraEgress": {"type": "array"}}},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "extraContainers": {"type": "array"},
    "extraInitContainers": {"type": "array"},
    "extraManifests": {"type": "array"}
  },
  "$defs": {
    "persistence": {"type": "object", "additionalProperties": false, "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain", "annotations"], "properties": {"enabled": {"type": "boolean"}, "existingClaim": {"type": "string"}, "storageClass": {"type": "string"}, "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}}, "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"}, "retain": {"type": "boolean"}, "annotations": {"type": "object"}}},
    "probe": {"type": "object", "required": ["enabled", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"], "properties": {"enabled": {"type": "boolean"}, "initialDelaySeconds": {"type": "integer", "minimum": 0}, "periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "failureThreshold": {"type": "integer", "minimum": 1}}}
  }
}
