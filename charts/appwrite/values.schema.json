{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Appwrite Helm Chart Values",
  "description": "Configuration for Appwrite self-hosted backend-as-a-service platform",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name used in resource names"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full release name used in resource names"
    },
    "commonLabels": {
      "type": "object",
      "description": "Labels added to every resource created by this chart"
    },
    "image": {
      "type": "object",
      "description": "Appwrite server container image",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "console": {
      "type": "object",
      "description": "Appwrite console image settings",
      "properties": {
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Image pull secrets for private registries"
    },
    "appwrite": {
      "type": "object",
      "description": "Appwrite application configuration",
      "properties": {
        "locale": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "openSslKeyV1": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretOpenSslKey": {
          "type": "string"
        },
        "existingSecretJwtKey": {
          "type": "string"
        },
        "logging": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "",
                "default",
                "sentry"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "pretty",
                "json"
              ]
            },
            "sentryDsn": {
              "type": "string"
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "string" },
            "secure": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string" }
          }
        },
        "usageStats": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "graphql": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "functions": {
          "type": "object",
          "properties": {
            "timeout": { "type": "integer", "minimum": 1 },
            "runtimes": { "type": "string" }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "limit": { "type": "integer", "minimum": 1 },
            "antivirus": { "type": "string", "enum": ["enabled", "disabled"] }
          }
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "api": {
      "type": "object",
      "description": "API server settings",
      "properties": {
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    },
    "realtime": {
      "type": "object",
      "description": "Realtime server settings",
      "properties": {
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    },
    "workers": {
      "type": "object",
      "description": "Worker deployment settings",
      "properties": {
        "audits": {
          "properties": {
            "enabled": {
              "const": false,
              "description": "worker-audits was removed in Appwrite 2.0",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "jobs": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "screenshots": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "executions": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "notifications": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "webhooks": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "deletes": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "databases": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "builds": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "certificates": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "functions": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "mails": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "messaging": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "migrations": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "statsResources": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } },
        "statsUsage": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "replicaCount": { "type": "integer", "minimum": 0 } } }
      }
    },
    "schedulers": {
      "type": "object",
      "description": "Scheduler deployment settings",
      "properties": {
        "functions": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "messages": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "executions": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
      }
    },
    "maintenance": {
      "type": "object",
      "description": "Maintenance task settings",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "tasks": {
      "type": "object",
      "description": "Background task settings",
      "properties": {
        "statsResources": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
      }
    },
    "database": {
      "type": "object",
      "description": "Database connection settings",
      "properties": {
        "adapter": {
          "type": "string",
          "const": "mariadb"
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "external"
          ]
        },
        "external": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "rootUser": { "type": "string" },
            "rootPassword": { "type": "string" },
            "name": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string" }
          }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "description": "MariaDB subchart configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string", "const": "standalone" },
        "auth": {
          "type": "object",
          "properties": {
            "database": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "rootPassword": { "type": "string" }
          }
        },
        "standalone": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" }
              }
            }
          }
        },
        "config": {
          "type": "object",
          "properties": { "myCnf": { "type": "string" } }
        }
      }
    },
    "cache": {
      "type": "object",
      "description": "Cache (Redis) connection settings",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "external"
          ]
        },
        "external": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string" }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "description": "Redis subchart configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string", "const": "standalone" },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "password": { "type": "string" }
          }
        },
        "standalone": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" }
              }
            },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "description": "Shared PVC configuration for Appwrite data",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "uploads": { "type": "object", "properties": { "size": { "type": "string" } } },
        "cache": { "type": "object", "properties": { "size": { "type": "string" } } },
        "certificates": { "type": "object", "properties": { "size": { "type": "string" } } },
        "functions": { "type": "object", "properties": { "size": { "type": "string" } } },
        "builds": { "type": "object", "properties": { "size": { "type": "string" } } },
        "sites": { "type": "object", "properties": { "size": { "type": "string" } } }
      }
    },
    "ingress": {
      "type": "object",
      "description": "Ingress configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "hosts": { "type": "array", "items": { "type": "object" } },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "service": {
      "type": "object",
      "description": "Service configuration",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        },
        "ipFamilyPolicy": {
          "type": "string",
          "description": "Service IP family policy (GR-058)",
          "enum": [
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ]
        },
        "ipFamilies": {
          "type": "array",
          "description": "Service IP families (GR-058)",
          "items": {
            "type": "string",
            "enum": [
              "IPv4",
              "IPv6"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "description": "ServiceAccount configuration",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "description": "Network isolation for Appwrite workloads",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } },
        "egress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "seccompProfile": {
          "type": "object",
          "properties": { "type": { "type": "string", "const": "RuntimeDefault" } }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "properties": { "drop": { "type": "array", "items": { "type": "string" } } }
        }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "backup": {
      "type": "object",
      "description": "Scheduled MariaDB backup to S3-compatible storage via mysqldump",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable scheduled MariaDB backup to S3-compatible storage"
        },
        "schedule": {
          "type": "string",
          "description": "Cron schedule for the backup job"
        },
        "suspend": {
          "type": "boolean",
          "description": "Suspend the CronJob"
        },
        "concurrencyPolicy": {
          "type": "string",
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "successfulJobsHistoryLimit": {
          "type": "integer"
        },
        "failedJobsHistoryLimit": {
          "type": "integer"
        },
        "backoffLimit": {
          "type": "integer"
        },
        "archivePrefix": {
          "type": "string"
        },
        "images": {
          "type": "object",
          "properties": {
            "mariadb": {
              "type": "string",
              "description": "MariaDB client image for mysqldump"
            },
            "uploader": {
              "type": "string",
              "description": "MinIO client image for S3 upload"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "runAsNonRoot": { "type": "boolean" },
            "runAsUser": { "type": "integer", "minimum": 1 },
            "runAsGroup": { "type": "integer", "minimum": 1 },
            "fsGroup": { "type": "integer", "minimum": 1 },
            "seccompProfile": {
              "type": "object",
              "properties": { "type": { "type": "string", "const": "RuntimeDefault" } }
            }
          }
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "allowPrivilegeEscalation": { "type": "boolean" },
            "readOnlyRootFilesystem": { "type": "boolean" },
            "capabilities": {
              "type": "object",
              "properties": { "drop": { "type": "array", "items": { "type": "string" } } }
            }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "mysqldumpArgs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra arguments passed to mysqldump without shell evaluation"
            }
          }
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "S3-compatible endpoint URL"
            },
            "bucket": {
              "type": "string",
              "description": "S3 bucket name"
            },
            "prefix": {
              "type": "string",
              "description": "S3 key prefix inside the bucket"
            },
            "createBucketIfNotExists": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string",
              "description": "Existing secret with S3 credentials"
            },
            "existingSecretAccessKeyKey": {
              "type": "string"
            },
            "existingSecretSecretKeyKey": {
              "type": "string"
            },
            "accessKey": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "gateway": {
      "type": "object",
      "description": "Gateway API configuration (GR-060)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array"
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "description": "ExternalSecrets configuration (GR-061)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "apiVersion": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] }
          }
        },
        "target": {
          "type": "object",
          "properties": { "creationPolicy": { "type": "string" } }
        },
        "data": {
          "type": "array"
        }
      }
    }
  }
}
