{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Wallabag Helm Chart Values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name used in resource names",
      "default": ""
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full resource name prefix",
      "default": ""
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": true,
      "description": "Labels added to every rendered resource"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "description": "Wallabag container image",
          "default": "docker.io/wallabag/wallabag"
        },
        "tag": {
          "type": "string",
          "description": "Image tag",
          "default": "2.6.14",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy",
          "default": "IfNotPresent",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "description": "Image pull secrets for private registries"
    },
    "wallabag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "description": "Port the bundled nginx listener binds inside the container",
          "default": 80,
          "minimum": 1,
          "maximum": 65535
        },
        "domainName": {
          "type": "string",
          "description": "Public URL users reach Wallabag through (scheme and host, no trailing slash)",
          "default": "https://wallabag.example.com",
          "pattern": "^https?://[^/]+$"
        },
        "serverName": {
          "type": "string",
          "description": "Instance name shown in the Wallabag UI and API",
          "default": "Wallabag"
        },
        "secret": {
          "type": "string",
          "description": "Symfony secret (generated once and preserved across upgrades when empty)",
          "default": ""
        },
        "existingSecret": {
          "type": "string",
          "description": "Existing Secret containing the Symfony secret",
          "default": ""
        },
        "existingSecretKey": {
          "type": "string",
          "description": "Key in the existing Secret holding the Symfony secret",
          "default": "symfony-secret"
        },
        "registration": {
          "type": "boolean",
          "description": "Allow public user registration",
          "default": false
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "description": "Username of the initial super-admin created on first install",
              "default": "wallabag"
            },
            "email": {
              "type": "string",
              "description": "Email of the initial super-admin created on first install",
              "default": "wallabag@example.com",
              "pattern": "^[^@ ]+@[^@ ]+$"
            },
            "password": {
              "type": "string",
              "description": "Initial super-admin password (generated once and preserved when empty)",
              "default": ""
            },
            "existingSecret": {
              "type": "string",
              "description": "Existing Secret containing the initial super-admin password",
              "default": ""
            },
            "existingSecretPasswordKey": {
              "type": "string",
              "description": "Key in the existing Secret holding the super-admin password",
              "default": "admin-password"
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": true
          },
          "description": "Extra environment variables for the Wallabag container"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run the database setup init container (schema install on first start, migrations on upgrade)",
          "default": true
        },
        "databaseWaitTimeoutSeconds": {
          "type": "integer",
          "description": "Seconds to wait for PostgreSQL before the setup init container fails",
          "default": 300,
          "minimum": 10
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "description": "Resources for the setup init container"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "description": "External PostgreSQL host (required when postgresql.enabled=false)",
              "default": ""
            },
            "port": {
              "type": [
                "string",
                "integer"
              ],
              "description": "External PostgreSQL port",
              "default": "5432",
              "pattern": "^[0-9]+$",
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string",
              "description": "External PostgreSQL database name",
              "default": "wallabag"
            },
            "username": {
              "type": "string",
              "description": "External PostgreSQL username",
              "default": "wallabag"
            },
            "password": {
              "type": "string",
              "description": "External PostgreSQL password (ignored when existingSecret is set)",
              "default": ""
            },
            "existingSecret": {
              "type": "string",
              "description": "Existing Secret containing the database password",
              "default": ""
            },
            "existingSecretPasswordKey": {
              "type": "string",
              "description": "Key in the existing Secret containing the password",
              "default": "password"
            }
          }
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "External Redis host for asynchronous imports (used when redis.enabled=false)",
          "default": ""
        },
        "port": {
          "type": [
            "string",
            "integer"
          ],
          "description": "External Redis port",
          "default": "6379",
          "pattern": "^[0-9]+$",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "type": "string",
          "description": "External Redis password (ignored when existingSecret is set)",
          "default": ""
        },
        "existingSecret": {
          "type": "string",
          "description": "Existing Secret containing the external Redis password",
          "default": ""
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "description": "Key in the existing Secret containing the Redis password",
          "default": "redis-password"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable persistence for /var/www/wallabag/data",
          "default": true
        },
        "size": {
          "type": "string",
          "description": "Storage size",
          "default": "2Gi",
          "pattern": "^[0-9]+([.][0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class",
          "default": ""
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          },
          "description": "Access modes",
          "minItems": 1
        },
        "existingClaim": {
          "type": "string",
          "description": "Use an existing PVC",
          "default": ""
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a ServiceAccount",
          "default": false
        },
        "name": {
          "type": "string",
          "description": "ServiceAccount name",
          "default": ""
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "description": "Annotations for the ServiceAccount"
        }
      }
    },
    "automountServiceAccountToken": {
      "type": "boolean",
      "description": "Mount the ServiceAccount token into the pod (Wallabag does not call the Kubernetes API)",
      "default": false
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Service type",
          "default": "ClusterIP",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "description": "HTTP service port",
          "default": 80,
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "description": "Annotations for the Service"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ingress for Wallabag",
          "default": false
        },
        "ingressClassName": {
          "type": "string",
          "description": "Ingress class name (for example: traefik, nginx)",
          "default": "traefik"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "description": "Annotations for the Ingress"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          },
          "description": "Ingress hosts"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretName": {
                "type": "string"
              }
            }
          },
          "description": "Ingress TLS configuration"
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render Gateway API HTTPRoute resources",
          "default": false
        },
        "httpRoutes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "parentRefs": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "hostnames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "labels": {
                "type": "object"
              },
              "annotations": {
                "type": "object"
              }
            }
          },
          "description": "HTTPRoute definitions routed to the Wallabag Service by default"
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "HTTP path used by every probe (served by Wallabag through nginx and PHP-FPM)",
          "default": "/api/info",
          "pattern": "^/"
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable the startup probe",
              "default": true
            },
            "initialDelaySeconds": {
              "type": "integer",
              "description": "Initial delay before the first startup probe",
              "default": 15
            },
            "periodSeconds": {
              "type": "integer",
              "description": "Startup probe period",
              "default": 10
            },
            "timeoutSeconds": {
              "type": "integer",
              "description": "Startup probe timeout",
              "default": 5
            },
            "failureThreshold": {
              "type": "integer",
              "description": "Startup probe failure threshold",
              "default": 30
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable the liveness probe",
              "default": true
            },
            "initialDelaySeconds": {
              "type": "integer",
              "description": "Initial delay before the first liveness probe",
              "default": 0
            },
            "periodSeconds": {
              "type": "integer",
              "description": "Liveness probe period",
              "default": 15
            },
            "timeoutSeconds": {
              "type": "integer",
              "description": "Liveness probe timeout",
              "default": 5
            },
            "failureThreshold": {
              "type": "integer",
              "description": "Liveness probe failure threshold",
              "default": 3
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable the readiness probe",
              "default": true
            },
            "initialDelaySeconds": {
              "type": "integer",
              "description": "Initial delay before the first readiness probe",
              "default": 0
            },
            "periodSeconds": {
              "type": "integer",
              "description": "Readiness probe period",
              "default": 10
            },
            "timeoutSeconds": {
              "type": "integer",
              "description": "Readiness probe timeout",
              "default": 5
            },
            "failureThreshold": {
              "type": "integer",
              "description": "Readiness probe failure threshold",
              "default": 3
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true,
      "description": "Resources for the Wallabag container"
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Pod security context. The upstream image starts as root and drops to nobody for PHP.",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "description": "Container security context for the Wallabag and setup containers",
      "additionalProperties": true
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable scheduled PostgreSQL backups to S3-compatible storage",
          "default": false
        },
        "schedule": {
          "type": "string",
          "description": "Cron schedule for backups (default: daily at 03:00 UTC)",
          "default": "0 3 * * *",
          "minLength": 1
        },
        "suspend": {
          "type": "boolean",
          "description": "Suspend the CronJob without deleting it",
          "default": false
        },
        "concurrencyPolicy": {
          "type": "string",
          "description": "Concurrency policy: Forbid, Replace, Allow",
          "default": "Forbid",
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "description": "Number of successful job records to keep",
          "default": 3
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "description": "Number of failed job records to keep",
          "default": 3
        },
        "backoffLimit": {
          "type": "integer",
          "description": "Maximum retries per backup job",
          "default": 1
        },
        "archivePrefix": {
          "type": "string",
          "description": "Prefix for backup archive filenames",
          "default": "wallabag"
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgresql": {
              "type": "string",
              "description": "Image used for PostgreSQL backup (must have pg_dump)",
              "default": "docker.io/library/postgres:18-alpine"
            },
            "uploader": {
              "type": "string",
              "description": "Image used for S3 upload (MinIO client)",
              "default": "docker.io/helmforge/mc:1.0.0"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "description": "Resources for backup containers"
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "S3-compatible endpoint URL",
              "default": ""
            },
            "bucket": {
              "type": "string",
              "description": "Target bucket name",
              "default": ""
            },
            "prefix": {
              "type": "string",
              "description": "Key prefix within the bucket",
              "default": "wallabag"
            },
            "createBucketIfNotExists": {
              "type": "boolean",
              "description": "Auto-create the bucket if it does not exist",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "description": "Use an existing secret for S3 credentials",
              "default": ""
            },
            "existingSecretAccessKeyKey": {
              "type": "string",
              "description": "Key in the existing secret for the access key",
              "default": "access-key"
            },
            "existingSecretSecretKeyKey": {
              "type": "string",
              "description": "Key in the existing secret for the secret key",
              "default": "secret-key"
            },
            "accessKey": {
              "type": "string",
              "description": "Inline S3 access key (ignored when existingSecret is set)",
              "default": ""
            },
            "secretKey": {
              "type": "string",
              "description": "Inline S3 secret key (ignored when existingSecret is set)",
              "default": ""
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "description": "Backup database host override",
              "default": ""
            },
            "port": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Backup database port override",
              "default": ""
            },
            "name": {
              "type": "string",
              "description": "Backup database name override",
              "default": ""
            },
            "username": {
              "type": "string",
              "description": "Backup database username override",
              "default": ""
            },
            "password": {
              "type": "string",
              "description": "Backup database password override",
              "default": ""
            },
            "existingSecret": {
              "type": "string",
              "description": "Existing Secret with the backup database password",
              "default": ""
            },
            "existingSecretPasswordKey": {
              "type": "string",
              "description": "Key in the backup database Secret",
              "default": "password"
            },
            "postgresDumpArgs": {
              "type": "string",
              "description": "Extra arguments appended to pg_dump",
              "default": ""
            }
          },
          "description": "Override database credentials for backup (uses app credentials if empty)"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true,
      "description": "Node selector for the Wallabag pod"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Tolerations for the Wallabag pod"
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true,
      "description": "Affinity rules for the Wallabag pod"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Topology spread constraints for the Wallabag pod"
    },
    "priorityClassName": {
      "type": "string",
      "description": "Priority class name for the Wallabag pod",
      "default": ""
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "description": "Grace period for PHP-FPM and nginx to drain",
      "default": 30,
      "minimum": 0
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extra labels for the Wallabag pod"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extra annotations for the Wallabag pod"
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Extra volumes for the Wallabag pod"
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Extra volume mounts for the Wallabag container"
    },
    "extraManifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Extra manifests to deploy alongside the chart"
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy PostgreSQL as a subchart",
          "default": true
        },
        "architecture": {
          "type": "string",
          "description": "PostgreSQL subchart architecture",
          "default": "standalone"
        },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "database": {
              "type": "string",
              "description": "Database created for Wallabag",
              "default": "wallabag"
            },
            "username": {
              "type": "string",
              "description": "Database user created for Wallabag",
              "default": "wallabag"
            },
            "password": {
              "type": "string",
              "description": "PostgreSQL password (auto-generated if empty)",
              "default": ""
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy Redis as a subchart (asynchronous import queue; requires import workers, see DESIGN.md)",
          "default": false
        },
        "architecture": {
          "type": "string",
          "description": "Redis subchart architecture",
          "default": "standalone"
        },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "password": {
              "type": "string",
              "description": "Redis password (auto-generated by the subchart if empty)",
              "default": ""
            }
          }
        }
      }
    }
  },
  "description": "Values for the Wallabag Helm chart: self-hosted read-it-later with PostgreSQL and optional Redis"
}
