{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "NautilusTrader Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "not": {"enum": ["latest", "stable", "edge", "nightly"]}},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "live": {
      "type": "object",
      "required": ["enabled", "mode", "factory", "nodeConfig"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["validate", "live"]},
        "factory": {"type": "string"},
        "command": {"type": "array"},
        "args": {"type": "array"},
        "nodeConfig": {"type": "object"},
        "extraEnv": {"type": "array"},
        "envFrom": {"type": "array"}
      }
    },
    "runner": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "readinessTimeoutSeconds": {"type": "integer", "minimum": 1},
        "logLevel": {"type": "string", "minLength": 1}
      }
    },
    "backtest": {"type": "object"},
    "scheduledBacktest": {"type": "object"},
    "secrets": {"type": "object"},
    "externalSecrets": {"type": "object"},
    "database": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["none", "postgresql", "external"]},
        "external": {"type": "object"}
      }
    },
    "messageBus": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["none", "redis", "external"]},
        "cacheDatabase": {"type": "integer", "minimum": 0},
        "busDatabase": {"type": "integer", "minimum": 0},
        "external": {"type": "object"}
      }
    },
    "postgresql": {"type": "object"},
    "redis": {"type": "object"},
    "persistence": {"type": "object"},
    "serviceAccount": {"type": "object"},
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"},
        "ipFamilyPolicy": {"enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"]},
        "ipFamilies": {"type": "array", "items": {"enum": ["IPv4", "IPv6"]}}
      }
    },
    "monitoring": {"type": "object"},
    "probes": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "networkPolicy": {"type": "object"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "extraInitContainers": {"type": "array"},
    "extraContainers": {"type": "array"},
    "extraManifests": {"type": "array"}
  },
  "required": ["image", "live", "runner", "backtest", "scheduledBacktest", "database", "messageBus", "persistence", "service"]
}
