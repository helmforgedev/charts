{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Open WebUI Helm Chart Values",
  "description": "Values for the Open WebUI Helm chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object", "additionalProperties": true },
    "nameOverride": { "type": "string", "default": "" },
    "fullnameOverride": { "type": "string", "default": "" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "openWebui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "existingSecretKey", "openaiExistingSecretKey", "doNotTrack"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secretKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "ollamaBaseUrl": { "type": "string" },
        "openaiBaseUrl": { "type": "string" },
        "openaiApiKey": { "type": "string" },
        "openaiExistingSecret": { "type": "string" },
        "openaiExistingSecretKey": { "type": "string", "minLength": 1 },
        "doNotTrack": { "type": "boolean" },
        "extraEnv": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "existingSecretKey"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "sqlite", "external"] },
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "redisConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "existingSecretKey"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "external", "disabled"] },
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClass", "accessModes", "existingClaim"],
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)$" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] } },
        "existingClaim": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "egress": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hosts", "secretName"],
            "properties": {
              "hosts": { "type": "array", "items": { "type": "string" } },
              "secretName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "resources": { "type": "object", "additionalProperties": true },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "seccompProfile": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "drop": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schedule", "suspend", "concurrencyPolicy", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "backoffLimit", "archivePrefix", "images", "resources", "database", "s3"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "archivePrefix": { "type": "string", "minLength": 1 },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgresql", "uploader"],
          "properties": {
            "postgresql": { "type": "string", "minLength": 1 },
            "uploader": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "type": "object", "additionalProperties": true },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pgDumpArgs", "host", "port", "name", "username", "existingSecret", "existingSecretKey"],
          "properties": {
            "pgDumpArgs": { "type": "string" },
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "name": { "type": "string" },
            "username": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "bucket", "prefix", "createBucketIfNotExists", "existingSecret", "existingSecretAccessKeyKey", "existingSecretSecretKeyKey", "accessKey", "secretKey"],
          "properties": {
            "endpoint": { "type": "string" },
            "bucket": { "type": "string" },
            "prefix": { "type": "string" },
            "createBucketIfNotExists": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "existingSecretAccessKeyKey": { "type": "string", "minLength": 1 },
            "existingSecretSecretKeyKey": { "type": "string", "minLength": 1 },
            "accessKey": { "type": "string" },
            "secretKey": { "type": "string" }
          }
        }
      }
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "tolerations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "affinity": { "type": "object", "additionalProperties": true },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "extraVolumes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "extraManifests": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "database": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        },
        "primary": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": { "type": "string" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "password": { "type": "string" }
          }
        },
        "master": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
