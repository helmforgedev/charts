{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Pimcore Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global settings shared by the chart.",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": true
    },
    "containerPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http",
        "phpFpm",
        "mercure"
      ],
      "properties": {
        "http": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "phpFpm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "mercure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest",
              "stable",
              "main",
              "master",
              "edge"
            ]
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "waitForDependencies": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "latest",
                  "stable",
                  "main",
                  "master",
                  "edge"
                ]
              }
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nginx": {
      "type": "object",
      "required": [
        "image",
        "clientMaxBodySize",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "latest",
                  "stable",
                  "main",
                  "master",
                  "edge"
                ]
              }
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "clientMaxBodySize": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "runtimeImage",
        "bootstrap",
        "persistence"
      ],
      "properties": {
        "runtimeImage": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "latest",
                  "stable",
                  "main",
                  "master",
                  "edge"
                ]
              }
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "object",
          "required": [
            "enabled",
            "skeletonVersion"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "skeletonVersion": {
              "type": "string",
              "pattern": "^20[0-9]{2}\\.[0-9]+\\.[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "required": [
            "enabled",
            "storageClass",
            "accessModes",
            "size",
            "existingClaim",
            "annotations"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$"
            },
            "existingClaim": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "required": [
        "replicaCount",
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount",
        "transports",
        "memoryLimit",
        "timeLimit",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "memoryLimit": {
          "type": "string",
          "minLength": 1
        },
        "timeLimit": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "required": [
        "enabled",
        "schedule",
        "concurrencyPolicy",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "concurrencyPolicy": {
          "type": "string",
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "required": [
        "enabled",
        "profile",
        "hookDeletePolicy",
        "backoffLimit",
        "activeDeadlineSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "hookDeletePolicy": {
          "type": "string",
          "minLength": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        }
      },
      "additionalProperties": false
    },
    "pimcore": {
      "type": "object",
      "required": [
        "environment",
        "debug",
        "trustedProxies",
        "trustedHosts",
        "mercureURL",
        "opensearchDSN",
        "extraEnv",
        "extraEnvFrom"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "prod",
            "dev",
            "test"
          ]
        },
        "debug": {
          "type": "boolean"
        },
        "trustedProxies": {
          "type": "string"
        },
        "trustedHosts": {
          "type": "string"
        },
        "mercureURL": {
          "type": "string"
        },
        "opensearchDSN": {
          "type": "string"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "applicationSecretKey": {
          "type": "string"
        },
        "adminPasswordKey": {
          "type": "string"
        },
        "productKeyKey": {
          "type": "string"
        },
        "instanceIdentifierKey": {
          "type": "string"
        },
        "encryptionSecretKey": {
          "type": "string"
        },
        "mercureJWTKey": {
          "type": "string"
        },
        "applicationSecret": {
          "type": "string"
        },
        "adminUser": {
          "type": "string"
        },
        "adminPassword": {
          "type": "string"
        },
        "productKey": {
          "type": "string"
        },
        "instanceIdentifier": {
          "type": "string"
        },
        "encryptionSecret": {
          "type": "string"
        },
        "mercureJWT": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "mode",
        "serverVersion",
        "external"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "mariadb",
            "external"
          ]
        },
        "serverVersion": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "mariadb": {
      "type": "object",
      "additionalProperties": true
    },
    "queue": {
      "type": "object",
      "required": [
        "mode",
        "external"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "rabbitmq",
            "external"
          ]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "username": {
              "type": "string"
            },
            "vhost": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "rabbitmq": {
      "type": "object",
      "additionalProperties": true
    },
    "cache": {
      "type": "object",
      "required": [
        "enabled",
        "mode",
        "external"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "redis",
            "external"
          ]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string"
            },
            "tls": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "additionalProperties": true
    },
    "mercure": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "replicaCount",
        "anonymous",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "latest",
                  "stable",
                  "main",
                  "master",
                  "edge"
                ]
              }
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "anonymous": {
          "type": "boolean"
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": [
        "persistence"
      ],
      "properties": {
        "persistence": {
          "type": "object",
          "required": [
            "enabled",
            "storageClass",
            "accessModes",
            "size",
            "existingClaim",
            "annotations"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$"
            },
            "existingClaim": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true
        },
        "ipFamilyPolicy": {
          "type": "string"
        },
        "ipFamilies": {
          "type": "array",
          "items": {}
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressClassName": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true
        },
        "hosts": {
          "type": "array",
          "items": {}
        },
        "tls": {
          "type": "array",
          "items": {}
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpRoutes": {
          "type": "array",
          "items": {}
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {}
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {}
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowDNS": {
              "type": "boolean"
            },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespaceSelector": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "matchLabels": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kubernetes.io/metadata.name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "podSelector": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "matchLabels": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "k8s-app": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "extraEgress": {
              "type": "array",
              "items": {}
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "nginxSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "startupProbe": {
      "type": "object",
      "required": [
        "enabled",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "livenessProbe": {
      "type": "object",
      "required": [
        "enabled",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readinessProbe": {
      "type": "object",
      "required": [
        "enabled",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": true
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraManifests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "containerPorts",
    "image",
    "imagePullSecrets",
    "waitForDependencies",
    "nginx",
    "project",
    "web",
    "worker",
    "maintenance",
    "install",
    "pimcore",
    "auth",
    "database",
    "mariadb",
    "queue",
    "rabbitmq",
    "cache",
    "redis",
    "mercure",
    "assets",
    "service"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest",
              "stable",
              "main",
              "master",
              "edge"
            ]
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "storageClass",
        "accessModes",
        "size",
        "existingClaim",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$"
        },
        "existingClaim": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "enabled",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
